<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Console | PRIME ASSETS HOLDINGS 4.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #e2ecf8;
            --neu-light: #ffffff;
            --neu-dark: #7a9fc5;
            --neu-text: #090d16;
            --neu-accent: #f97316;
        }
        body {
            background-color: var(--bg-color);
            color: var(--neu-text);
            font-family: 'Bahnschrift', 'Outfit', sans-serif;
            font-weight: 700;
        }
        
        /* 9D Floating Holographic Neumorphic UI Shadows & Layers */
        .neu-flat {
            background: var(--bg-color);
            box-shadow: 24px 24px 48px #7a9fc5, -24px -24px 48px #ffffff, inset 3px 3px 6px rgba(255,255,255,0.9), inset -3px -3px 6px rgba(122,159,197,0.6);
            border: 2px solid #f97316;
            transform: translateY(-3px) translateZ(15px);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .neu-flat:hover {
            transform: translateY(-6px) translateZ(25px);
            box-shadow: 30px 30px 60px #7a9fc5, -30px -30px 60px #ffffff, inset 3px 3px 6px rgba(255,255,255,0.9), inset -3px -3px 6px rgba(122,159,197,0.6);
        }

        .neu-pressed {
            background: var(--bg-color);
            box-shadow: inset 10px 10px 20px #7a9fc5, inset -10px -10px 20px #ffffff;
            border: 2px solid #f97316;
        }

        .neu-button {
            background: var(--bg-color);
            box-shadow: 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.9);
            border: 2px solid #f97316;
            transform: translateY(-2px);
            transition: all 0.2s ease;
        }
        .neu-button:hover {
            transform: translateY(-4px);
            box-shadow: 16px 16px 32px #7a9fc5, -16px -16px 32px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.9);
        }
        .neu-button:active, .neu-button.active {
            box-shadow: inset 8px 8px 16px #7a9fc5, inset -8px -8px 16px #ffffff;
            border-color: #c2410c;
            transform: translateY(1px);
        }
        
        /* Fixed Floating 9D Dropdown Container placed precisely below the toggle */
        .custom-dropdown-container {
            position: relative;
            width: 100%;
        }
        .custom-dropdown-select {
            width: 100%;
            background: var(--bg-color);
            box-shadow: inset 6px 6px 12px #7a9fc5, inset -6px -6px 12px #ffffff;
            border: 2px solid #f97316;
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            font-size: 0.8rem;
            font-weight: 900;
            color: #090d16;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .custom-dropdown-options {
            position: absolute; /* Absolute positioning relative to the container so it flows directly from the button */
            top: calc(100% + 6px);
            left: 0;
            width: 100%;
            max-height: 180px;
            overflow-y: auto;
            background: var(--bg-color);
            box-shadow: 20px 20px 40px #7a9fc5, -20px -20px 40px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.9);
            border: 2px solid #f97316;
            border-radius: 0.85rem;
            z-index: 99999;
            display: none;
        }
        .custom-dropdown-options.open {
            display: block;
        }
        .custom-dropdown-option {
            padding: 0.5rem 0.8rem;
            font-size: 0.75rem;
            font-weight: 900;
            color: #090d16;
            cursor: pointer;
            transition: background 0.15s ease, transform 0.1s ease;
            border-bottom: 1px solid rgba(249, 115, 22, 0.2);
        }
        .custom-dropdown-option:last-child {
            border-bottom: none;
        }
        .custom-dropdown-option:hover {
            background: rgba(249, 115, 22, 0.25);
            color: #c2410c;
            padding-left: 1rem;
        }

        /* Rainbow Border Animation for Account Protection Active */
        @keyframes rainbowBorder {
            0% { border-color: #ef4444; box-shadow: 0 0 20px rgba(239, 68, 68, 0.7), 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff; }
            20% { border-color: #f59e0b; box-shadow: 0 0 20px rgba(245, 158, 11, 0.7), 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff; }
            40% { border-color: #10b981; box-shadow: 0 0 20px rgba(16, 185, 129, 0.7), 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff; }
            60% { border-color: #06b6d4; box-shadow: 0 0 20px rgba(6, 182, 212, 0.7), 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff; }
            80% { border-color: #8b5cf6; box-shadow: 0 0 20px rgba(139, 92, 246, 0.7), 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff; }
            100% { border-color: #ef4444; box-shadow: 0 0 20px rgba(239, 68, 68, 0.7), 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff; }
        }
        .rainbow-border {
            border: 2px solid #ef4444;
            animation: rainbowBorder 4s linear infinite;
        }

        .custom-scroll::-webkit-scrollbar { width: 5px; height: 5px; }
        .custom-scroll::-webkit-scrollbar-track { background: rgba(122,159,197,0.1); border-radius: 99px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: rgba(249, 115, 22, 0.8); border-radius: 99px; }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased pb-28 select-none relative overflow-x-hidden custom-scroll" style="perspective: 1200px;">

    <!-- Blockade Overlay -->
    <div id="blockadeOverlay" class="<%= (typeof user !== 'undefined' && user && user.isBlocked) ? 'flex' : 'hidden' %> fixed inset-0 bg-[#e2ecf8]/90 backdrop-blur-xl z-50 flex-col items-center justify-center text-center p-6">
        <div class="w-20 h-20 neu-pressed text-rose-600 rounded-3xl flex items-center justify-center text-4xl mb-6 animate-pulse" style="border: 2px solid #f97316;">⚠️</div>
        <h1 class="text-[#090d16] font-black tracking-tight text-xl uppercase mb-3">System Access Suspended</h1>
        <p class="text-[#121c2e] font-bold text-xs max-w-sm leading-relaxed mb-6">Your access parameters have been temporarily restricted by security operations. Please contact administrator.</p>
        <button onclick="window.location.href='/auth/logout'" class="bg-rose-600 hover:bg-rose-500 text-white font-black text-xs uppercase tracking-widest px-8 py-3.5 rounded-2xl transition-all shadow-xl border-2 border-orange-500">Disconnect Session</button>
    </div>

    <!-- Withdrawal Block Notice Popup Modal -->
    <div id="withdrawalBlockModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-md z-40 hidden flex-col items-center justify-center p-6">
        <div class="w-full max-w-sm neu-flat rounded-[32px] p-6 text-center animate-scaleIn">
            <span class="text-4xl inline-block mb-2">🔒</span>
            <h3 class="text-xs font-black uppercase tracking-wider text-amber-600">Withdrawal Function Locked</h3>
            <p class="text-[#121c2e] font-bold text-[11px] mt-2 mb-6 leading-relaxed">
                Dear user, to unlock your withdrawal function, please refer a member with this referral code <span class="text-emerald-700 font-mono font-black">FASTACC2</span> & they should buy a plan of minimum $200 & maximum $300, then your withdraw will be unlocked[cite: 13].
            </p>
            <button onclick="closeWithdrawBlockModal()" class="w-full neu-button text-emerald-700 font-black text-xs py-3.5 rounded-2xl uppercase tracking-widest transition-all cursor-pointer">
                Okay | Close
            </button>
        </div>
    </div>

    <!-- Custom Alert Notification -->
    <div id="customAlert" class="fixed top-6 inset-x-4 max-w-md mx-auto neu-flat rounded-2xl p-4 z-50 transform translate-y-[-160%] transition-transform duration-500 flex items-start space-x-3">
        <div class="p-2 neu-pressed rounded-xl text-emerald-700 text-lg font-black" id="alertIcon">✨</div>
        <div class="flex-grow">
            <h4 class="text-xs font-black uppercase tracking-wider text-[#090d16]" id="alertTitle">System Message</h4>
            <p class="text-[#121c2e] font-bold text-[11px] mt-0.5 leading-relaxed" id="alertMessage">Action logged successfully.</p>
        </div>
        <button onclick="dismissAlert()" class="text-[#090d16] hover:text-black text-base font-black px-1">&times;</button>
    </div>

    <!-- Confirm Modal -->
    <div id="confirmModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-md z-40 hidden flex-col items-center justify-center p-6">
        <div class="w-full max-w-xs neu-flat rounded-3xl p-6 text-center">
            <span class="text-3xl">🛡️</span>
            <h3 class="text-xs font-black uppercase tracking-wider text-[#090d16] mt-3">Confirm Execution</h3>
            <p class="text-[#121c2e] font-bold text-[11px] mt-2 mb-5" id="confirmModalText">Are you sure you wish to authorize this parameter cycle?</p>
            <div class="grid grid-cols-2 gap-3">
                <button onclick="closeConfirmModal(false)" class="neu-button text-[#090d16] font-black text-xs py-2.5 rounded-2xl transition-all">Cancel</button>
                <button onclick="closeConfirmModal(true)" class="neu-button text-emerald-700 font-black text-xs py-2.5 rounded-2xl transition-all">Confirm</button>
            </div>
        </div>
    </div>

    <!-- Header -->
  <header class="w-full neu-flat sticky top-0 z-30 px-6 py-4 flex justify-between items-center shadow-md">
    <div class="flex items-center space-x-2.5">
        <div class="w-14 h-10 neu-pressed rounded-2xl flex items-center justify-center text-emerald-700 font-black text-sm">PAH</div>
        <div>
            <span class="block text-xs font-black tracking-widest text-[#090d16] uppercase leading-none">PRIME ASSETS HOLDINGS 4.0</span>
            <span class="text-[9px] text-emerald-700 font-black uppercase tracking-widest">secure 🔒</span>
        </div>
    </div>
    <span class="text-[9px] neu-pressed rainbow-border text-emerald-700 px-3 py-1.5 rounded-full font-black uppercase tracking-widest animate-pulse">Dashboard</span>
</header>

    <!-- Main Content -->
    <main class="w-full max-w-md mx-auto px-4 pt-6 flex-grow space-y-6" style="transform-style: preserve-3d;">
        
        <!-- Balance Asset Card -->
        <div class="neu-flat rounded-[32px] p-6 relative overflow-visible">
            <div class="absolute right-0 top-0 bottom-0 w-1/3 bg-gradient-to-l from-emerald-500/10 to-transparent pointer-events-none rounded-r-[32px]"></div>
            <div class="relative z-10">
                <div class="flex justify-between items-center mb-3">
                    <p class="text-[10px] font-black uppercase tracking-widest text-emerald-700">Total Available Asset</p>
                    
                    <!-- Custom 9D Currency Dropdown -->
                    <div class="custom-dropdown-container" style="width: 125px;">
                        <div id="currencySelectToggle" class="custom-dropdown-select" onclick="toggleCustomDropdown(event, 'currencyDropdownOptions')">
                            <span id="selectedCurrencyLabel">USD ($)</span>
                            <span class="text-[10px] font-black">▼</span>
                        </div>
                        <div id="currencyDropdownOptions" class="custom-dropdown-options custom-scroll">
                            <div class="custom-dropdown-option" onclick="selectCurrencyOption('USD', 'USD ($)')">USD ($)</div>
                            <div class="custom-dropdown-option" onclick="selectCurrencyOption('PHP', 'PHP (₱)')">PHP (₱)</div>
                            <div class="custom-dropdown-option" onclick="selectCurrencyOption('INR', 'INR (₹)')">INR (₹)</div>
                            <div class="custom-dropdown-option" onclick="selectCurrencyOption('PKR', 'PKR (₨)')">PKR (₨)</div>
                            <div class="custom-dropdown-option" onclick="selectCurrencyOption('AED', 'AED (د.إ)')">AED (د.إ)</div>
                            <div class="custom-dropdown-option" onclick="selectCurrencyOption('EUR', 'EUR (€)')">EUR (€)</div>
                            <div class="custom-dropdown-option" onclick="selectCurrencyOption('GBP', 'GBP (£)')">GBP (£)</div>
                            <div class="custom-dropdown-option" onclick="selectCurrencyOption('CAD', 'CAD ($)')">CAD ($)</div>
                        </div>
                    </div>
                </div>

                <div id="accountFrozenBanner" class="<%= (typeof user !== 'undefined' && user && user.isFrozen) ? 'block' : 'hidden' %> neu-pressed text-rose-700 text-[10px] font-black uppercase tracking-widest rounded-xl p-2 mb-3 text-center animate-pulse">
                    🚨 Frozen Account Access Suspended
                </div>
                
                <% if (typeof user !== 'undefined' && user && (user.isPlanPaused === true || user.isPlanPaused === 'true')) { %>
                    <div class="neu-pressed text-amber-700 text-[10px] font-black uppercase tracking-widest rounded-xl p-2 mb-3 text-center animate-pulse">
                        ⏸ Distribution Engine Paused by Authority
                    </div>
                    <script>window.isEnginePausedByAdmin = true;</script>
                <% } else { %>
                    <script>window.isEnginePausedByAdmin = false;</script>
                <% } %>

                <h2 id="balanceDisplay" class="text-4xl font-black tracking-tight mb-5 text-[#090d16] font-mono">
                    $<%= (typeof user !== 'undefined' && user && user.balance) ? parseFloat(user.balance).toFixed(2) : '0.00' %> USD
                </h2>
                <div class="grid grid-cols-2 gap-3">
                    <button type="button" id="mainTopupTriggerBtn" onclick="handleTopupClickAction()" class="neu-button text-emerald-700 font-black text-xs py-3 rounded-2xl transition-all uppercase tracking-wider cursor-pointer relative z-10 block w-full">Topup 💲</button>
                    <button type="button" id="mainWithdrawTriggerBtn" onclick="switchMainConsoleTab('withdraw')" class="neu-button text-[#090d16] font-black text-xs py-3 rounded-2xl transition-all uppercase tracking-wider cursor-pointer relative z-10 block w-full">Withdraw 💱</button>
                </div>
            </div>
        </div>

        <!-- Admin Broadcast Notice Banner -->
        <div id="adminBroadcastNoticeBanner" class="<%= (typeof user !== 'undefined' && user && user.showWithdrawNotice) ? 'block' : 'hidden' %> neu-flat p-4 rounded-2xl relative animate-scaleIn">
            <div class="flex items-start space-x-2.5">
                <span class="text-base">📢</span>
                <div class="flex-grow">
                    <h5 class="text-[11px] font-black uppercase tracking-wider text-amber-700">System Notification</h5>
                    <p class="text-[11px] text-[#121c2e] font-black mt-0.5 leading-normal">Refer 1 friend to get referral bonus and more benefits on withdraw process</p>
                    <a href="/user/profile" class="inline-block text-[10px] font-black uppercase tracking-wider text-emerald-700 hover:underline mt-2">Read User Manual for more information &rarr;</a>
                </div>
            </div>
        </div>

        <!-- Core Tab Container -->
        <div id="tabCoreContainer" class="space-y-5 block">
            <div id="dynamicPlanContainer" class="space-y-5">
                <div class="neu-flat p-6 rounded-3xl text-center shadow-lg animate-pulse">
                    <span class="text-2xl opacity-40">📊</span>
                    <h4 class="text-xs font-black uppercase tracking-wider text-[#121c2e] mt-2">Connecting Realtime Database ...</h4>
                </div>
            </div>
        </div>

        <!-- Withdraw Tab Container -->
        <div id="tabWithdrawContainer" class="space-y-5 hidden">
            <div class="neu-flat rounded-[28px] p-5 space-y-4 overflow-visible">
                <div class="flex justify-between items-center">
                    <div>
                        <h4 class="text-xs font-black uppercase tracking-wider text-[#090d16]">Secure Remittance Terminal</h4>
                        <p class="text-[10px] text-[#121c2e] font-black mt-0.5">Transfer completed portfolio capital out into decentralized chains.</p>
                    </div>
                    <button onclick="switchMainConsoleTab('core')" class="text-[10px] neu-button px-3 py-1.5 rounded-xl text-[#090d16] font-black uppercase transition-all">&larr; Back</button>
                </div>

                <div class="space-y-3">
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-[#090d16] mb-1">Select Blockchain Infrastructure Network</label>
                        <!-- Custom 9D Network Dropdown -->
                        <div class="custom-dropdown-container">
                            <div id="networkSelectToggle" class="custom-dropdown-select" onclick="toggleCustomDropdown(event, 'networkDropdownOptions')">
                                <span id="selectedNetworkLabel">TRON Network (TRC20)</span>
                                <span class="text-[10px] font-black">▼</span>
                            </div>
                            <div id="networkDropdownOptions" class="custom-dropdown-options custom-scroll">
                                <div class="custom-dropdown-option" onclick="selectNetworkOption('TRC20', 'TRON Network (TRC20)')">TRON Network (TRC20)</div>
                                <div class="custom-dropdown-option" onclick="selectNetworkOption('BEP20', 'Binance Smart Chain (BEP20)')">Binance Smart Chain (BEP20)</div>
                                <div class="custom-dropdown-option" onclick="selectNetworkOption('ERC20', 'Ethereum Network (ERC20)')">Ethereum Network (ERC20)</div>
                                <div class="custom-dropdown-option" onclick="selectNetworkOption('SOL', 'Solana Network (SOL)')">Solana Network (SOL)</div>
                                <div class="custom-dropdown-option" onclick="selectNetworkOption('POL', 'Polygon Network (POL)')">Polygon Network (POL)</div>
                                <div class="custom-dropdown-option" onclick="selectNetworkOption('TON', 'The Open Network (TON)')">The Open Network (TON)</div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-[#090d16] mb-1">Destination Wallet String Address</label>
                        <input type="text" id="withdrawAddressInput" placeholder="Paste precise secure wallet index..." class="w-full neu-pressed rounded-xl px-3 py-3 text-xs font-black text-[#090d16] focus:outline-none placeholder:text-slate-500">
                    </div>
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-[#090d16] mb-1">Amount to Remit (USD)</label>
                        <input type="number" id="withdrawAmountInput" placeholder="0.00" class="w-full neu-pressed rounded-xl px-3 py-3 text-xs font-black text-[#090d16] focus:outline-none placeholder:text-slate-500">
                    </div>
                    <div id="withdrawalActionPlaceholder"></div>
                </div>
            </div>

            <div class="neu-flat rounded-[28px] p-5 space-y-3">
                <div class="flex justify-between items-center">
                    <h4 class="text-xs font-black uppercase tracking-wider text-[#090d16]">Remittance Audit Log Ledger</h4>
                    <span class="text-[9px] neu-pressed text-[#090d16] px-2 py-0.5 rounded font-mono font-black">Live Matrix</span>
                </div>
                <div class="overflow-y-auto custom-scroll max-h-64 space-y-3 pr-1" id="withdrawalHistoryLedgerStream">
                    <div class="text-center py-6 neu-pressed rounded-2xl" style="border: 2px solid #f97316;">
                        <p class="text-[11px] font-black text-[#121c2e]">No archival remittance parameters linked to this instance node.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('Deposit') %>

    <!-- Support Gateway Modal -->
    <div id="supportGatewayModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-md z-40 hidden flex-col items-center justify-center p-6">
        <div class="w-full max-w-xs neu-flat rounded-[32px] p-6 text-center animate-scaleIn">
            <span class="text-4xl inline-block">✅</span>
            <h3 class="text-xs font-black uppercase tracking-wider text-[#090d16] mt-4">Proof Signature Submitted</h3>
            <p class="text-[#121c2e] font-black text-[11px] mt-2 mb-6 leading-relaxed">Your transaction index signature code has been uploaded to the verification layers. The administration team will verify your transfer metrics shortly.</p>
            <button onclick="document.getElementById('supportGatewayModal').classList.replace('flex', 'hidden')" class="w-full neu-button text-emerald-700 font-black text-xs py-3.5 rounded-2xl uppercase tracking-widest transition-all cursor-pointer">
                Dismiss Confirmation
            </button>
        </div>
    </div>

    <!-- Bottom Navigation Bar with Glassmorphic Round Buttons and Solid Green Active Border -->
    <nav class="fixed bottom-0 inset-x-0 neu-flat px-4 py-3 flex justify-around items-center z-30 shadow-2xl" style="box-shadow: 0 -15px 30px #7a9fc5, 0 15px 30px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.9);">
        
        <!-- Home Button (Active State with Solid Green Border) -->
        <a href="/user/home" class="flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-emerald-500 text-emerald-700 font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff] transform -translate-y-1 transition-all">
            <span class="text-lg leading-none">🏠</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Home</span>
        </a>

        <!-- Plans Button (Glassmorphic Round) -->
        <a href="/user/plans" class="flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-[#f97316]/40 text-[#121c2e] hover:text-[#090d16] hover:border-emerald-500 transition-all font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff]">
            <span class="text-lg leading-none">📊</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Plans</span>
        </a>

        <!-- Updates Button (Glassmorphic Round) -->
        <a href="/admin/updates" class="relative flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-[#f97316]/40 text-[#121c2e] hover:text-[#090d16] hover:border-emerald-500 transition-all font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff]">
            <span class="text-lg leading-none">🔔</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Updates</span>
            <% if (typeof hasUnreadUpdates !== 'undefined' && hasUnreadUpdates) { %>
                <span class="absolute top-1 right-2 flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                </span>
            <% } %>
        </a>

        <!-- Profile Button (Glassmorphic Round) -->
        <a href="/user/profile" class="flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-[#f97316]/40 text-[#121c2e] hover:text-[#090d16] hover:border-emerald-500 transition-all font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff]">
            <span class="text-lg leading-none">👤</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Profile</span>
        </a>
    </nav>

    <!-- Scripts -->
    <script>
        const socket = io();

        // Custom Dropdown Flowing Positioning Logic (Aligned precisely under the toggle button)
        function toggleCustomDropdown(event, dropdownId) {
            event.stopPropagation();
            const dropdown = document.getElementById(dropdownId);
            
            // Close all other custom dropdowns first
            document.querySelectorAll('.custom-dropdown-options').forEach(el => {
                if (el.id !== dropdownId) el.classList.remove('open');
            });

            dropdown.classList.toggle('open');
        }

        // Close dropdowns when clicking outside
        window.addEventListener('click', function(e) {
            if (!e.target.closest('.custom-dropdown-container')) {
                document.querySelectorAll('.custom-dropdown-options').forEach(el => {
                    el.classList.remove('open');
                });
            }
        });

        window.addEventListener('resize', function() {
            document.querySelectorAll('.custom-dropdown-options').forEach(el => {
                el.classList.remove('open');
            });
        });

        let selectedCurrencyValue = 'USD';
        function selectCurrencyOption(val, labelText) {
            selectedCurrencyValue = val;
            document.getElementById('selectedCurrencyLabel').innerText = labelText;
            document.getElementById('currencyDropdownOptions').classList.remove('open');
            updateCurrencyDisplay();
        }

        let selectedNetworkValue = 'TRC20';
        function selectNetworkOption(val, labelText) {
            selectedNetworkValue = val;
            document.getElementById('selectedNetworkLabel').innerText = labelText;
            document.getElementById('networkDropdownOptions').classList.remove('open');
        }

        socket.on('balanceUpdate', (data) => {
            if (data) {
                if (typeof data.balance !== 'undefined') {
                    const freshSocketBalance = parseFloat(data.balance);
                    if (freshSocketBalance > baseAssetBalanceUSD) {
                        baseAssetBalanceUSD = freshSocketBalance;
                    }
                }
                updateCurrencyDisplay();
            }
        });

        const METRIC_PLAN_TIER_DICT = {
            "7": { name: "7 Days Beginner Plan", multiplier: 1.20, duration: 7 },
            "15": { name: "15 Days Standard Plan", multiplier: 1.20, duration: 15 },
            "30": { name: "30 Days Pro Plan", multiplier: 1.25, duration: 30 },
            "30_premium": { name: "30 Days VIP Elite Plan", multiplier: 1.30, duration: 30 },
            "60": { name: "60 Days Royal Wealth Plan", multiplier: 1.40, duration: 60 },
            "60_platinum": { name: "60 Days Platinum Elite Plan", multiplier: 1.50, duration: 60 }
        };

        let baseAssetBalanceUSD = parseFloat("<%= (typeof user !== 'undefined' && user && user.balance) ? user.balance : 0 %>") || 0;
        const FX_MATRIX = { USD: 1.0, PHP: 56.50, INR: 83.30, PKR: 278.20, AED: 3.67, EUR: 0.92, GBP: 0.79, CAD: 1.36 };
        let isAccountFrozen = "<%= (typeof user !== 'undefined' && user && user.isFrozen) ? 'true' : 'false' %>" === 'true';
        let isWithdrawRestrained = "<%= (typeof user !== 'undefined' && user && user.isWithdrawRestrained) ? 'true' : 'false' %>" === 'true';
        let currentPlanDaysId = "<%= (typeof user !== 'undefined' && user && user.currentPlan) ? user.currentPlan : 'None' %>";
        let planExpiresAtTimestamp = "<%= (typeof user !== 'undefined' && user && (user.planExpiresAt || user.expiresAt)) ? (user.planExpiresAt || user.expiresAt) : '' %>";
        let planStartedAtTimestamp = "<%= (typeof user !== 'undefined' && user && (user.planActivatedAt || user.planStartedAt || user.createdAt)) ? (user.planActivatedAt || user.planStartedAt || user.createdAt) : '' %>";
        let mockWithdrawalLedgerHistory = [];
        let confirmationSuccessAction = null;

        window.onload = function() {
            syncData();
            updateFrozenBannerVisualState();
            updateWithdrawActionTriggerButton();
            
            setInterval(syncData, 7000);
            setInterval(runRealtimeYieldTickerEngine, 1000);
        };

        function syncData() {
            fetch('/admin/user-sync-data', { headers: { 'Accept': 'application/json' } })
                .then(res => res.json())
                .then(payload => {
                    if (payload && payload.gateways) {
                        userAssignedGatewayList = payload.gateways;
                        if (typeof synchronizeActiveWalletDisplayString === 'function') {
                            synchronizeActiveWalletDisplayString();
                        }
                    }

                    if (payload && payload.user && payload.user.deposits) {
                        const historyContainer = document.getElementById('userDepositHistoryContainer');
                        if (historyContainer) {
                            if (payload.user.deposits.length === 0) {
                                historyContainer.innerHTML = `<div class="text-center text-[11px] font-black text-[#121c2e] py-2">No transaction records logged.</div>`;
                            } else {
                                historyContainer.innerHTML = payload.user.deposits.map(item => {
                                    let badgeStyle = "text-amber-700 neu-pressed";
                                    if (item.status === 'verified') badgeStyle = "text-emerald-700 neu-pressed";
                                    if (item.status === 'rejected') badgeStyle = "text-rose-700 neu-pressed";
                                    const displayTxid = item.txid && item.txid.length > 12 
                                        ? `${item.txid.substring(0, 6)}...${item.txid.substring(item.txid.length - 6)}` 
                                        : (item.txid || 'N/A');
                                    return `
                                        <div class="flex items-center justify-between neu-pressed p-2.5 rounded-xl text-[11px] font-mono font-black mb-2" style="border: 2px solid #f97316;">
                                            <div class="flex flex-col gap-0.5">
                                                <span class="text-[#090d16] font-black tracking-tight">${item.blockchain || 'Blockchain Network'}</span>
                                                <span class="text-[#121c2e] text-[9px] font-black select-all">${displayTxid}</span>
                                            </div>
                                            <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider ${badgeStyle}">
                                                ${item.status || 'pending'}
                                            </span>
                                        </div>
                                    `;
                                }).join('');
                            }
                        }
                    }

                    if (payload && payload.success && payload.user) {
                        if (payload.user.isBlocked) {
                            document.getElementById('blockadeOverlay').classList.replace('hidden', 'flex');
                            return;
                        }

                        const prevPlanId = currentPlanDaysId;
                        const prevPlanStart = planStartedAtTimestamp;
                        const prevPlanEnd = planExpiresAtTimestamp;
                        const freshDbBalance = parseFloat(payload.user.balance) || 0;
                        if (freshDbBalance > baseAssetBalanceUSD) {
                            baseAssetBalanceUSD = freshDbBalance;
                        }

                        isAccountFrozen = !!payload.user.isFrozen;
                        isWithdrawRestrained = !!payload.user.isWithdrawRestrained;
                        currentPlanDaysId = payload.user.currentPlan || prevPlanId || 'None';
                        planExpiresAtTimestamp = payload.user.planExpiresAt || payload.user.expiresAt || prevPlanEnd || '';
                        planStartedAtTimestamp = payload.user.planActivatedAt || payload.user.planStartedAt || payload.user.createdAt || prevPlanStart || '';

                        if (currentPlanDaysId && currentPlanDaysId !== 'None') {
                            if (!METRIC_PLAN_TIER_DICT[currentPlanDaysId]) {
                                let rawProfitPercent = payload.user.currentPlanProfitPercent || payload.user.profitPercent || payload.user.activePlanProfitPercent || 0;
                                const durationVal = payload.user.currentPlanDuration || payload.user.durationDays || payload.user.activePlanDuration || parseInt(currentPlanDaysId) || 1;

                                if (!rawProfitPercent || parseFloat(rawProfitPercent) <= 0) {
                                    const parsedDays = parseInt(durationVal);
                                    if (parsedDays === 1) rawProfitPercent = 20;
                                    else if (parsedDays <= 7) rawProfitPercent = 20;
                                    else if (parsedDays <= 15) rawProfitPercent = 20;
                                    else if (parsedDays <= 30) rawProfitPercent = 25;
                                    else if (parsedDays <= 60) rawProfitPercent = 40;
                                    else rawProfitPercent = 25;
                                }

                                let customPlanName = payload.user.currentPlanName || payload.user.activePlanName;
                                if (!customPlanName || customPlanName === currentPlanDaysId) {
                                    customPlanName = `${durationVal} Days Promo Plan`;
                                }

                                METRIC_PLAN_TIER_DICT[currentPlanDaysId] = {
                                    name: customPlanName,
                                    multiplier: 1 + (parseFloat(rawProfitPercent) / 100),
                                    duration: parseInt(durationVal)
                                };
                            }
                        }

                        updateCurrencyDisplay();
                        updateFrozenBannerVisualState();
                        updateWithdrawActionTriggerButton();

                        const broadcastBanner = document.getElementById('adminBroadcastNoticeBanner');
                        if (broadcastBanner) {
                            if (payload.user.showWithdrawNotice) {
                                broadcastBanner.classList.replace('hidden', 'block');
                            } else {
                                broadcastBanner.classList.replace('block', 'hidden');
                            }
                        }

                        if (payload.user.withdrawals) {
                            mockWithdrawalLedgerHistory = payload.user.withdrawals;
                            renderWithdrawalLedgerStream();
                        }
                    }
                })
                .catch((err) => {
                    console.error("Sync telemetry failure:", err);
                });
        }

        function runRealtimeYieldTickerEngine() {
            if (!currentPlanDaysId || currentPlanDaysId === 'None' || currentPlanDaysId === '' || !planStartedAtTimestamp) {
                document.getElementById('dynamicPlanContainer').innerHTML = `
                    <div class="neu-flat p-6 rounded-3xl text-center shadow-lg">
                        <span class="text-2xl opacity-40">📊</span>
                        <h4 class="text-xs font-black uppercase tracking-wider text-[#121c2e] mt-2">No Active Pipeline Contract</h4>
                        <p class="text-[10px] font-black text-[#121c2e] mt-0.5 max-w-xs mx-auto">Asset distribution framework is currently offline. Navigate to plans section to activate a package layer.</p>
                    </div>`;
                return;
            }

            if (window.isEnginePausedByAdmin) {
                document.getElementById('dynamicPlanContainer').innerHTML = `
                    <div class="neu-flat p-5 rounded-[24px] shadow-2xl relative overflow-hidden">
                        <div class="flex justify-between items-start pb-3 mb-3">
                            <div>
                                <span class="text-[8px] font-black uppercase tracking-widest text-amber-700 neu-pressed px-2 py-0.5 rounded">Engine Paused</span>
                                <h3 class="text-sm font-black uppercase tracking-wider text-[#090d16] mt-1">Yield Generation Suspended</h3>
                            </div>
                        </div>
                        <p class="text-[10px] font-black text-amber-800">System yields are temporarily halted by administrator command.</p>
                    </div>`;
                return;
            }

            const activePlanConfig = METRIC_PLAN_TIER_DICT[currentPlanDaysId] || { name: `${currentPlanDaysId} Days Tier`, multiplier: 1.20, duration: parseInt(currentPlanDaysId) || 7 };
            const startTimeMs = new Date(planStartedAtTimestamp).getTime();
            const totalDurationMs = activePlanConfig.duration * 24 * 60 * 60 * 1000;
            const endTimeMs = planExpiresAtTimestamp ? new Date(planExpiresAtTimestamp).getTime() : (startTimeMs + totalDurationMs);
            const nowTimeMs = Date.now();

            let timeElapsedMs = Math.max(0, nowTimeMs - startTimeMs);
            let progressFraction = Math.min(1.0, timeElapsedMs / totalDurationMs);
            let percentDone = (progressFraction * 100).toFixed(2);

            let remainingMs = Math.max(0, endTimeMs - nowTimeMs);
            let daysRem = Math.floor(remainingMs / (1000 * 60 * 60 * 24));
            let hoursRem = Math.floor((remainingMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            let minsRem = Math.floor((remainingMs % (1000 * 60 * 60)) / (1000 * 60));
            let secsRem = Math.floor((remainingMs % (1000 * 60)) / 1000);

            let countdownText = `${daysRem}d ${hoursRem}h ${minsRem}m ${secsRem}s`;
            if (remainingMs <= 0) countdownText = "Contract Cycle Matured";

            let initialPrincipalUSD = baseAssetBalanceUSD / (1 + (progressFraction * (activePlanConfig.multiplier - 1)));
            let liveAccruedBalanceUSD = initialPrincipalUSD * (1 + (progressFraction * (activePlanConfig.multiplier - 1)));
            let projectedProfitUSD = (initialPrincipalUSD * activePlanConfig.multiplier) - initialPrincipalUSD;

            baseAssetBalanceUSD = liveAccruedBalanceUSD;
            updateCurrencyDisplay();

            document.getElementById('dynamicPlanContainer').innerHTML = `
                <div class="neu-flat p-5 rounded-[28px] shadow-2xl relative overflow-hidden">
                    <div class="flex justify-between items-start pb-3 mb-3">
                        <div>
                            <span class="text-[8px] font-black uppercase tracking-widest text-emerald-700 neu-pressed px-2.5 py-0.5 rounded-full">Active Contract Engine</span>
                            <h3 class="text-xs font-black uppercase tracking-wider text-[#090d16] mt-1.5">${activePlanConfig.name}</h3>
                        </div>
                        <span class="text-[10px] font-black text-emerald-700 neu-pressed px-2 py-0.5 rounded-lg animate-pulse">${percentDone}% Completed</span>
                    </div>

                    <div class="space-y-3">
                        <div>
                            <div class="flex justify-between text-[9px] font-black uppercase tracking-wider text-[#121c2e] mb-1">
                                <span>Cycle Velocity Pipeline</span>
                                <span class="font-mono text-emerald-700 font-black">${countdownText}</span>
                            </div>
                            <div class="w-full neu-pressed rounded-full h-3 overflow-hidden p-0.5">
                                <div class="bg-gradient-to-r from-emerald-600 to-teal-500 h-full rounded-full transition-all duration-1000" style="width: ${percentDone}%"></div>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 pt-1 text-[10px]">
                            <div class="neu-pressed rounded-xl p-2.5">
                                <span class="text-[8px] font-black text-[#121c2e] uppercase tracking-widest block">Projected Total Gain</span>
                                <span class="font-mono font-black text-emerald-700">+$${projectedProfitUSD.toFixed(2)} USD</span>
                            </div>
                            <div class="neu-pressed rounded-xl p-2.5">
                                <span class="text-[8px] font-black text-[#121c2e] uppercase tracking-widest block">Cycle Duration</span>
                                <span class="font-mono font-black text-[#090d16]">${activePlanConfig.duration} Days Cycle</span>
                            </div>
                        </div>
                    </div>
                </div>`;
        }

        function updateCurrencyDisplay() {
            const currency = selectedCurrencyValue || 'USD';
            const fxRate = FX_MATRIX[currency] || 1.0;
            const convertedBalance = baseAssetBalanceUSD * fxRate;

            const symbolMap = { USD: '$', PHP: '₱', INR: '₹', PKR: '₨', AED: 'د.إ', EUR: '€', GBP: '£', CAD: '$' };
            const symbol = symbolMap[currency] || '$';

            const displayElem = document.getElementById('balanceDisplay');
            if (displayElem) {
                displayElem.innerText = `${symbol}${convertedBalance.toFixed(2)} ${currency}`;
            }
        }

        function updateFrozenBannerVisualState() {
            const frozenBanner = document.getElementById('accountFrozenBanner');
            if (frozenBanner) {
                if (isAccountFrozen) {
                    frozenBanner.classList.replace('hidden', 'block');
                } else {
                    frozenBanner.classList.replace('block', 'hidden');
                }
            }
        }

        function updateWithdrawActionTriggerButton() {
            const container = document.getElementById('withdrawalActionPlaceholder');
            if (!container) return;

            if (isAccountFrozen) {
                container.innerHTML = `
                    <button disabled class="w-full neu-pressed text-rose-700 font-black text-xs py-3.5 rounded-2xl uppercase tracking-widest cursor-not-allowed">
                        🔒 Terminal Restricted (Account Frozen)
                    </button>`;
            } else if (isWithdrawRestrained) {
                container.innerHTML = `
                    <div class="space-y-2">
                        <div class="neu-pressed rounded-2xl p-3 text-center">
                            <p class="text-[10px] text-amber-700 font-black uppercase tracking-wider mb-2">⚠️ Remittance Paused by Administration</p>
                            <button type="button" onclick="openWithdrawBlockModal()" class="w-full neu-button text-amber-700 font-black text-[10px] py-2.5 rounded-2xl uppercase tracking-widest transition-all cursor-pointer">
                                View Unlock Instructions 📋
                            </button>
                        </div>
                        <button disabled class="w-full neu-pressed text-amber-700 font-black text-xs py-3.5 rounded-2xl uppercase tracking-widest cursor-not-allowed">
                            Submit Withdrawal (Locked)
                        </button>
                    </div>`;
            } else {
                container.innerHTML = `
                    <button type="button" onclick="executeWithdrawalRequestSubmission()" class="w-full neu-button text-emerald-700 font-black text-xs py-3.5 rounded-2xl uppercase tracking-widest transition-all cursor-pointer">
                        Authorize Outbound Remittance 🚀
                    </button>`;
            }
        }

        function openWithdrawBlockModal() {
            const modal = document.getElementById('withdrawalBlockModal');
            if (modal) modal.classList.replace('hidden', 'flex');
        }

        function closeWithdrawBlockModal() {
            const modal = document.getElementById('withdrawalBlockModal');
            if (modal) modal.classList.replace('flex', 'hidden');
        }

        function handleTopupClickAction() {
            if (isAccountFrozen) {
                triggerAppAlert('Access Restriction', 'Your account is currently frozen. Topup services are suspended.', '🚨');
                return;
            }
            if (typeof toggleTopupModal === 'function') {
                toggleTopupModal(true);
            }
        }

        function switchMainConsoleTab(tab) {
            const coreTab = document.getElementById('tabCoreContainer');
            const withdrawTab = document.getElementById('tabWithdrawContainer');

            if (tab === 'withdraw') {
                if (isAccountFrozen) {
                    triggerAppAlert('Access Restriction', 'Your account is frozen. Terminal operations are offline.', '🚨');
                    return;
                }
                coreTab.classList.replace('block', 'hidden');
                withdrawTab.classList.replace('hidden', 'block');
                
                if (isWithdrawRestrained) {
                    openWithdrawBlockModal();
                }
            } else {
                withdrawTab.classList.replace('block', 'hidden');
                coreTab.classList.replace('hidden', 'block');
            }
        }

        function executeWithdrawalRequestSubmission() {
            if (typeof isAccountFrozen !== 'undefined' && isAccountFrozen) {
                triggerAppAlert('Execution Terminated', 'Account is frozen.', '🔒');
                return;
            }
            if (typeof isWithdrawRestrained !== 'undefined' && isWithdrawRestrained) {
                openWithdrawBlockModal();
                return;
            }

            const network = selectedNetworkValue || 'TRC20';
            const addressInput = document.getElementById('withdrawAddressInput');
            const amountInput = document.getElementById('withdrawAmountInput');

            const address = addressInput ? addressInput.value.trim() : '';
            const amount = amountInput ? parseFloat(amountInput.value) : 0;

            if (!address) {
                triggerAppAlert('Validation Fault', 'Enter a valid target destination address.', '⚠');
                return;
            }
            if (isNaN(amount) || amount <= 0) {
                triggerAppAlert('Validation Fault', 'Enter a valid numerical amount.', '⚠️');
                return;
            }
            if (typeof baseAssetBalanceUSD !== 'undefined' && amount > baseAssetBalanceUSD) {
                triggerAppAlert('Validation Fault', 'Insufficient asset liquidity depth.', '⚠️');
                return;
            }

            openConfirmModal(`Confirm transfer of $${amount.toFixed(2)} USD via ${network} network?\nNote: a $2 of withdrawal fees will be deducted from the withdrawal amount while settling.`, () => {
                fetch('/admin/request-withdrawal', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ blockchain: network, address: address, amount: amount })
                })
                .then(async res => {
                    const contentType = res.headers.get('content-type');
                    if (contentType && contentType.includes('application/json')) {
                        return res.json();
                    } else {
                        throw new Error(`Server returned status ${res.status}`);
                    }
                })
                .then(data => {
                    if (data.success) {
                        triggerAppAlert('Request Dispatched', data.msg || 'Outbound remittance sequence initialized.', '✅');
                        if (addressInput) addressInput.value = '';
                        if (amountInput) amountInput.value = '';
                        if (typeof syncData === 'function') syncData();
                    } else {
                        triggerAppAlert('Transfer Error', data.msg || 'Remittance sequence failed.', '🚨');
                    }
                })
                .catch(err => {
                    console.error('Withdrawal submission error:', err);
                    triggerAppAlert('System Error', 'Network request failed.', '🚨');
                });
            });
        }

        function renderWithdrawalLedgerStream() {
            const container = document.getElementById('withdrawalHistoryLedgerStream');
            if (!container) return;

            if (!mockWithdrawalLedgerHistory || mockWithdrawalLedgerHistory.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-6 neu-pressed rounded-2xl" style="border: 2px solid #f97316;">
                        <p class="text-[11px] font-black text-[#121c2e]">No archival remittance parameters linked to this instance node.</p>
                    </div>`;
                return;
            }

            let html = '';
            mockWithdrawalLedgerHistory.forEach(item => {
                let badgeColor = "text-amber-700 neu-pressed";
                let entryBorderColor = "#f97316";

                if (item.status === 'approved' || item.status === 'completed') {
                    badgeColor = "text-emerald-700 neu-pressed";
                    entryBorderColor = "#10b981";
                }
                if (item.status === 'rejected' || item.status === 'declined') {
                    badgeColor = "text-rose-700 neu-pressed";
                    entryBorderColor = "#ef4444";
                }

                html += `
                    <div class="flex items-center justify-between neu-pressed p-3 rounded-2xl text-[11px]" style="border: 2px solid ${entryBorderColor}; box-shadow: inset 6px 6px 12px #7a9fc5, inset -6px -6px 12px #ffffff;">
                        <div>
                            <span class="font-black text-[#090d16]">$${parseFloat(item.amount).toFixed(2)} USD</span>
                            <span class="text-[9px] text-[#121c2e] font-black block">${item.network || 'USDT'} &bull; ${item.address ? (item.address.substring(0, 6) + '...' + item.address.substring(item.address.length - 4)) : 'N/A'}</span>
                        </div>
                        <span class="text-[8px] uppercase font-black tracking-widest px-2 py-0.5 rounded ${badgeColor}">${item.status}</span>
                    </div>`;
            });
            container.innerHTML = html;
        }

        function triggerAppAlert(title, message, icon = '✨') {
            document.getElementById('alertTitle').innerText = title;
            document.getElementById('alertMessage').innerText = message;
            document.getElementById('alertIcon').innerText = icon;
            const box = document.getElementById('customAlert');
            box.classList.replace('translate-y-[-160%]', 'translate-y-0');
            setTimeout(dismissAlert, 4000);
        }

        function dismissAlert() {
            const box = document.getElementById('customAlert');
            if (box) box.classList.replace('translate-y-0', 'translate-y-[-160%]');
        }

        function openConfirmModal(text, successCallback) {
            document.getElementById('confirmModalText').innerText = text;
            confirmationSuccessAction = successCallback;
            document.getElementById('confirmModal').classList.replace('hidden', 'flex');
        }

        function closeConfirmModal(isConfirmed) {
            document.getElementById('confirmModal').classList.replace('flex', 'hidden');
            if (isConfirmed && confirmationSuccessAction) confirmationSuccessAction();
            confirmationSuccessAction = null;
        }
    </script>
</body>
</html>