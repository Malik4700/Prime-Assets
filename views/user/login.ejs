<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Console Login | PRIME ASSETS HOLDINGS 4.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes gradientFlow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .animate-gradient-text {
            background-size: 200% auto;
            animation: gradientFlow 4s linear infinite;
        }
    </style>
</head>
<body class="bg-[#f2f9f6] text-slate-800 min-h-screen flex flex-col justify-between font-sans relative overflow-x-hidden antialiased select-none">

    <canvas id="bubbleCanvas" class="absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>
    
    <canvas id="fireworksCanvas" class="absolute inset-0 w-full h-full pointer-events-none z-40 transition-opacity duration-1000 ease-out"></canvas>

    <header class="w-full bg-white/40 backdrop-blur-md border-b border-white/60 text-center py-3 text-xs font-bold uppercase tracking-widest text-emerald-700 shadow-[0_2px_10px_rgba(16,185,129,0.02)] z-10">
        Welcome to the <span class="text-slate-900 font-extrabold tracking-normal">PRIME ASSETS HOLDINGS 4.0</span> Premium Analytics & Resource Console
    </header>

    <main class="flex-grow flex flex-col items-center justify-center p-4 sm:p-6 z-10 space-y-4">
        <a href="/" class="bg-white/80 backdrop-blur-md border border-slate-200/60 text-slate-500 hover:text-emerald-600 hover:border-emerald-500/30 text-xs font-bold uppercase tracking-widest py-2 px-5 rounded-xl transition-all duration-200 shadow-sm transform active:scale-95">
            &larr; Home
        </a>

        <div class="bg-white/40 backdrop-blur-3xl border border-white/90 p-6 sm:p-8 rounded-[2.5rem] shadow-[0_30px_70px_rgba(148,163,184,0.12)] max-w-sm w-full transition-all duration-500 hover:shadow-[0_40px_80px_rgba(16,185,129,0.14)] hover:scale-[1.01] hover:bg-white/50 group">
            
            <div class="mb-5 text-center">
                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-2 bg-gradient-to-r from-emerald-600 via-teal-500 to-indigo-600 bg-clip-text text-transparent animate-gradient-text filter drop-shadow-sm transition-transform duration-300 group-hover:scale-[1.02]">
                    Login
                </h1>
                <p class="text-xs text-emerald-600 font-extrabold tracking-widest uppercase">Welcome back! Let's get you signed in.</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-rose-500/10 border border-rose-200 text-rose-600 text-xs py-3 px-4 rounded-2xl mb-4 text-center tracking-wide font-medium shadow-sm">
                    <%= error %>
                </div>
            <% } %>

            <form action="/auth/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-[11px] font-bold uppercase text-slate-400 tracking-wider mb-1.5 pl-1">Email Address</label>
                    <input type="email" name="email" required placeholder="name@example.com"
                           class="w-full bg-white/90 border border-slate-200 rounded-2xl px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 shadow-sm hover:border-slate-300">
                </div>

                <div>
                    <label class="block text-[11px] font-bold uppercase text-slate-400 tracking-wider mb-1.5 pl-1">Password</label>
                    <div class="relative">
                        <input type="password" id="password" name="password" required placeholder="••••••••"
                               class="w-full bg-white/90 border border-slate-200 rounded-2xl pl-4 pr-12 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 shadow-sm hover:border-slate-300">
                        <button type="button" onclick="togglePassword('password', 'eyeOpenPass', 'eyeClosedPass')" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-emerald-600 focus:outline-none transition-colors duration-200">
                            <svg id="eyeOpenPass" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            <svg id="eyeClosedPass" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.025 10.025 0 014.132-5.4M9.9 4.24a9.122 9.122 0 012.1-.24c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.4M9.9 4.24L1.5 1.5M22.5 22.5L13.875 13.875M12 9a3 3 0 00-3 3" />
                            </svg>
                        </button>
                    </div>
                </div>
                
                <div class="flex items-center space-x-2 px-1 mt-2">
                    <input type="checkbox" id="rememberMeInput" onclick="handleRememberMeToggle()" class="accent-emerald-600 rounded border-slate-300 focus:ring-emerald-500 h-3.5 w-3.5 bg-white/50 cursor-pointer">
                    <label for="rememberMeInput" class="text-[11px] font-bold uppercase text-slate-400 tracking-wider cursor-pointer select-none">
                        Remember Me
                    </label>
                </div>

                <div class="pt-2">
                    <button type="submit" 
                            class="w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold py-3.5 px-4 rounded-2xl text-sm transition-all duration-300 shadow-lg shadow-emerald-600/15 hover:shadow-emerald-600/25 transform active:scale-[0.98] hover:translate-y-[-1px]">
                        Login
                    </button>
                </div>
            </form>

            <div class="mt-5 text-center text-xs text-slate-400 font-semibold tracking-wide">
                New platform user? <a href="/auth/signup" class="text-emerald-600 hover:text-emerald-500 hover:underline font-bold transition-colors duration-150 pl-1">Create Account</a>
            </div>
        </div>
    </main>

    <footer class="text-center py-5 text-[11px] text-slate-400 font-bold tracking-widest border-t border-white/40 z-10 bg-white/10 backdrop-blur-sm">
        &copy; 2026 PRIME ASSETS HOLDINGS &bull; RESOURCE MANAGEMENT ENGINE &bull; ALL RIGHTS RESERVED
    </footer>

    <script>
        const canvas = document.getElementById('bubbleCanvas');
        const ctx = canvas.getContext('2d');
        function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeCanvas); resizeCanvas();

        const bubbleData = [
            { flag: '🇬🇧', startColors: ['#22d3ee', '#0ea5e9'] }, { flag: '🇺🇸', startColors: ['#3b82f6', '#4f46e5'] },
            { flag: '🇩🇪', startColors: ['#fbbf24', '#f97316'] }, { flag: '🇯🇵', startColors: ['#fb7185', '#ef4444'] },
            { flag: '🇨🇦', startColors: ['#f87171', '#dc2626'] }, { flag: '🇦🇺', startColors: ['#2dd4bf', '#0d9488'] },
            { flag: '🇫🇷', startColors: ['#38bdf8', '#2563eb'] }, { flag: '🇧🇷', startColors: ['#34d399', '#16a34a'] },
            { flag: '🇦🇪', startColors: ['#4ade80', '#059669'] }, { flag: '🇸🇦', startColors: ['#10b981', '#15803d'] },
            { flag: '🇹🇷', startColors: ['#f43f5e', '#b91c1c'] }, { flag: '🇰🇷', startColors: ['#818cf8', '#5b21b6'] },
            { flag: '🇮🇹', startColors: ['#6ee7b7', '#0f766e'] }, { flag: '🇪🇸', startColors: ['#fcd24d', '#dc2626'] }
        ];

        class Bubble {
            constructor(flag, colors) {
                this.flag = flag; this.colors = colors; this.radius = window.innerWidth < 768 ? 28 : 32;
                this.x = Math.random() * (canvas.width - this.radius * 2) + this.radius;
                this.y = Math.random() * (canvas.height - this.radius * 2) + this.radius;
                this.vx = (Math.random() - 0.5) * 5.5; this.vy = (Math.random() - 0.5) * 5.5;
                if(Math.abs(this.vx) < 1.5) this.vx = this.vx < 0 ? -2.5 : 2.5;
                if(Math.abs(this.vy) < 1.5) this.vy = this.vy < 0 ? -2.5 : 2.5;
            }
            draw() {
                ctx.save(); ctx.beginPath(); ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                let gradient = ctx.createLinearGradient(this.x - this.radius, this.y - this.radius, this.x + this.radius, this.y + this.radius);
                gradient.addColorStop(0, this.colors[0]); gradient.addColorStop(1, this.colors[1]); ctx.fillStyle = gradient;
                ctx.shadowColor = 'rgba(0, 0, 0, 0.15)'; ctx.shadowBlur = 15; ctx.shadowOffsetY = 6; ctx.fill(); ctx.restore();
                ctx.font = `${this.radius * 0.95}px Arial`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(this.flag, this.x, this.y + 2);
            }
            update() {
                this.x += this.vx; this.y += this.vy;
                if (this.x - this.radius <= 0) { this.x = this.radius; this.vx *= -1; }
                else if (this.x + this.radius >= canvas.width) { this.x = canvas.width - this.radius; this.vx *= -1; }
                if (this.y - this.radius <= 0) { this.y = this.radius; this.vy *= -1; }
                else if (this.y + this.radius >= canvas.height) { this.y = canvas.height - this.radius; this.vy *= -1; }
            }
        }

        const bubbles = bubbleData.map(data => new Bubble(data.flag, data.startColors));
        function resolveCollisions() {
            for (let i = 0; i < bubbles.length; i++) {
                for (let j = i + 1; j < bubbles.length; j++) {
                    let b1 = bubbles[i]; let b2 = bubbles[j];
                    let dx = b2.x - b1.x; let dy = b2.y - b1.y;
                    let distance = Math.sqrt(dx * dx + dy * dy); let minDistance = b1.radius + b2.radius;
                    if (distance < minDistance) {
                        let overlap = minDistance - distance; let nx = dx / distance; let ny = dy / distance;
                        b1.x -= nx * (overlap / 2); b1.y -= ny * (overlap / 2); b2.x += nx * (overlap / 2); b2.y += ny * (overlap / 2);
                        let kx = b1.vx - b2.vx; let ky = b1.vy - b2.vy; let p = 2 * (nx * kx + ny * ky) / 2;
                        b1.vx -= p * nx; b1.vy -= p * ny; b2.vx += p * nx; b2.vy += p * ny;
                    }
                }
            }
        }
        function animate() { ctx.clearRect(0, 0, canvas.width, canvas.height); resolveCollisions(); bubbles.forEach(bubble => { bubble.update(); bubble.draw(); }); requestAnimationFrame(animate); }
        animate();

        function togglePassword(inputId, openIconId, closedIconId) {
            const inputField = document.getElementById(inputId);
            const eyeOpen = document.getElementById(openIconId);
            const eyeClosed = document.getElementById(closedIconId);
            if (inputField.type === "password") { inputField.type = "text"; eyeOpen.classList.add('hidden'); eyeClosed.classList.remove('hidden'); }
            else { inputField.type = "password"; eyeOpen.classList.remove('hidden'); eyeClosed.classList.add('hidden'); }
        }
    </script>

    <script>
        const fwCanvas = document.getElementById('fireworksCanvas');
        const fwCtx = fwCanvas.getContext('2d');
        let fwActive = true;
        function resizeFwCanvas() { fwCanvas.width = window.innerWidth; fwCanvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeFwCanvas); resizeFwCanvas();

        let particles = [];
        const colors = ['#10b981', '#06b6d4', '#3b82f6', '#6366f1', '#f59e0b', '#ec4899'];

        class Particle {
            constructor(x, y, color) {
                this.x = x; this.y = y; this.color = color;
                this.radius = Math.random() * 3 + 1;
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 6 + 2;
                this.vx = Math.cos(angle) * speed;
                this.vy = Math.sin(angle) * speed;
                this.alpha = 1;
                this.decay = Math.random() * 0.015 + 0.015;
            }
            draw() {
                fwCtx.save(); fwCtx.globalAlpha = this.alpha; fwCtx.beginPath();
                fwCtx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                fwCtx.fillStyle = this.color; fwCtx.fill(); fwCtx.restore();
            }
            update() { this.x += this.vx; this.y += this.vy; this.vy += 0.05; this.alpha -= this.decay; }
        }

        function spawnFirework() {
            if (!fwActive) return;
            const x = Math.random() * fwCanvas.width;
            const y = Math.random() * (fwCanvas.height * 0.6);
            const color = colors[Math.floor(Math.random() * colors.length)];
            for (let i = 0; i < 40; i++) { particles.push(new Particle(x, y, color)); }
        }

        let fireworkTimer = setInterval(spawnFirework, 350);

        function animateFireworks() {
            if (!fwActive && particles.length === 0) return;
            fwCtx.clearRect(0, 0, fwCanvas.width, fwCanvas.height);

            // Welcome Text parameters
            if (fwActive) {
                fwCtx.save(); fwCtx.font = "bold 2.5rem sans-serif"; fwCtx.textAlign = "center";
                let gradient = fwCtx.createLinearGradient(fwCanvas.width/2 - 100, 0, fwCanvas.width/2 + 100, 0);
                gradient.addColorStop(0, '#059669'); gradient.addColorStop(1, '#4f46e5');
                fwCtx.fillStyle = gradient; fwCtx.fillText("Welcome!", fwCanvas.width / 2, fwCanvas.height * 0.2);
                fwCtx.restore();
            }

            particles.forEach((p, i) => {
                p.update(); p.draw();
                if (p.alpha <= 0) particles.splice(i, 1);
            });
            requestAnimationFrame(animateFireworks);
        }
        animateFireworks();

        // 3-Second Absolute Cleanup Window
        setTimeout(() => {
            fwActive = false;
            clearInterval(fireworkTimer);
            fwCanvas.style.opacity = '0';
            setTimeout(() => {
                fwCanvas.remove();
            }, 1000);
        }, 3000);

        // ============================================================================
        // 🟢 REMEMBER ME LOCAL CACHING ENGINE
        // ============================================================================
        function saveCredentialsOnTheFly() {
            const rememberMe = document.getElementById('rememberMeInput').checked;
            if (rememberMe) {
                const email = document.querySelector('input[name="email"]').value;
                const password = document.getElementById('password').value;
                localStorage.setItem('rememberedEmail', email);
                localStorage.setItem('rememberedPassword', password);
            }
        }

        function handleRememberMeToggle() {
            const rememberMe = document.getElementById('rememberMeInput').checked;
            if (rememberMe) {
                saveCredentialsOnTheFly();
            } else {
                localStorage.removeItem('rememberedEmail');
                localStorage.removeItem('rememberedPassword');
            }
        }

        // Run automatically when the webpage environment finishes setting up
        (function loadStoredCredentials() {
            const savedEmail = localStorage.getItem('rememberedEmail');
            const savedPass = localStorage.getItem('rememberedPassword');
            
            if (savedEmail && savedPass) {
                document.querySelector('input[name="email"]').value = savedEmail;
                document.getElementById('password').value = savedPass;
                document.getElementById('rememberMeInput').checked = true;
            }
        })();

    </script>
</body>
</html>