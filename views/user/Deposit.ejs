<div id="topupGatewayModal" class="fixed inset-0 bg-black/85 backdrop-blur-xl z-50 hidden flex-col items-center justify-center p-4">
    <div class="w-full max-w-sm premium-bg-blend border border-white/20 rounded-[32px] p-6 shadow-2xl space-y-5 relative">
        <button onclick="toggleTopupModal(false)" class="absolute top-4 right-5 text-slate-400 hover:text-white text-xl font-bold">&times;</button>
        
        <div>
            <h4 class="text-xs font-black uppercase tracking-wider text-white">Deposit Liquid Capital</h4>
            <p class="text-[10px] text-slate-400 mt-0.5">Supply liquidity tokens directly to your verified active console pipeline nodes.</p>
        </div>
        
        <div class="space-y-4">
            <div>
                <label class="block text-[9px] font-black uppercase tracking-widest text-slate-400 mb-1">Select Active Network Protocol</label>
                <select id="userDepositNetworkSelector" onchange="synchronizeActiveWalletDisplayString()" class="w-full bg-black/60 border border-white/20 rounded-xl px-3 py-2.5 text-xs font-bold text-white focus:outline-none focus:border-emerald-500/40">
                    <option value="TRC20">TRON Network (TRC20)</option>
                    <option value="BEP20">Binance Smart Chain (BEP20)</option>
                    <option value="ERC20">Ethereum Network (ERC20)</option>
                </select>
            </div>

            <div class="bg-black/40 border border-white/10 rounded-2xl p-4 text-center space-y-2">
                <span class="text-[9px] font-black uppercase tracking-widest text-emerald-400">Target Transfer Address</span>
                <p id="topupWalletString" class="text-xs font-mono font-bold text-white break-all select-all py-1">Loading wallet parameter...</p>
                <button onclick="copyTopupWalletToClipboard()" class="bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-300 font-bold text-[10px] px-4 py-1.5 rounded-xl uppercase tracking-wider transition-all">Copy Address 📋</button>
            </div>

            <div>
                <label class="block text-[9px] font-black uppercase tracking-widest text-slate-400 mb-1">Transaction Proof Index (TXID / Hash)</label>
                <input type="text" id="topupTxidInput" placeholder="Paste generated blockchain TXID code..." class="w-full bg-black/60 border border-white/20 rounded-xl px-3 py-3 text-xs font-medium text-white focus:outline-none focus:border-emerald-500/40">
            </div>

            <button onclick="submitTopupTxidProof()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs py-3.5 rounded-xl uppercase tracking-widest shadow-lg transition-all cursor-pointer">
                Submit Deposit Signature 🚀
            </button>
        </div>

        <div class="border-t border-white/10 pt-4 space-y-2">
            <h5 class="text-[10px] font-black uppercase tracking-wider text-slate-300">Transaction History Log</h5>
            <div id="userDepositHistoryContainer" class="max-h-36 overflow-y-auto custom-scroll space-y-2 pr-1">
                <div class="text-center text-[11px] text-slate-500 py-2">No transaction records logged.</div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleTopupModal(show) {
        const modal = document.getElementById('topupGatewayModal');
        if (!modal) return;
        if (show) {
            modal.classList.replace('hidden', 'flex');
            synchronizeActiveWalletDisplayString();
        } else {
            modal.classList.replace('flex', 'hidden');
        }
    }

    function submitTopupTxidProof() {
    const network = document.getElementById('userDepositNetworkSelector').value;
    const txid = document.getElementById('topupTxidInput').value.trim();

    if (!txid) {
        if (typeof triggerAppAlert === 'function') {
            triggerAppAlert('Validation Error', 'Please enter a valid TXID or hash.', '⚠️');
        } else {
            alert('Please enter a valid TXID or hash.');
        }
        return;
    }

    // MATCHED ROUTE: /admin/report-deposit-proof
    fetch('/admin/report-deposit-proof', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ blockchain: network, txid: txid })
    })
    .then(async res => {
        const contentType = res.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
            return res.json();
        } else {
            throw new Error(`Server returned status ${res.status}`);
        }
    })
    .then(data => {
        if (data.success) {
            if (typeof triggerAppAlert === 'function') {
                triggerAppAlert('Request Sent', 'Your transaction proof has been submitted for review.', '✨');
            } else {
                alert('Your transaction proof has been submitted for review.');
            }
            document.getElementById('topupTxidInput').value = '';
            toggleTopupModal(false);
            if (typeof syncData === 'function') {
                syncData();
            }
        } else {
            if (typeof triggerAppAlert === 'function') {
                triggerAppAlert('Request Denied', data.msg || 'Transaction rejected by system.', '❌');
            } else {
                alert(data.msg || 'Transaction rejected by system.');
            }
        }
    })
    .catch(err => {
        console.error('Deposit submission network failure:', err);
        if (typeof triggerAppAlert === 'function') {
            triggerAppAlert('Network Failure', 'Failed to dispatch deposit proof payload.', '❌');
        } else {
            alert('Failed to dispatch deposit proof payload.');
        }
    });
}

    function synchronizeActiveWalletDisplayString() {
        const networkSelector = document.getElementById('userDepositNetworkSelector');
        const targetWalletTextElement = document.getElementById('topupWalletString');
        
        if (!networkSelector || !targetWalletTextElement) return;

        const activeNetworkSelection = networkSelector.value;
        const gatewayList = (typeof userAssignedGatewayList !== 'undefined' && Array.isArray(userAssignedGatewayList)) ? userAssignedGatewayList : [];

        if (gatewayList.length === 0) {
            targetWalletTextElement.innerText = "No active gateway address found";
            targetWalletTextElement.classList.add('text-rose-400');
            return;
        }

        const matchedConfig = gatewayList.find(item => {
            if (!item || !item.blockchain) return false;
            const dbValue = item.blockchain.toString().toUpperCase();
            const selectedValue = activeNetworkSelection.toUpperCase();
            return dbValue.includes(selectedValue) || selectedValue.includes(dbValue);
        });

        if (matchedConfig && matchedConfig.address) {
            targetWalletTextElement.innerText = matchedConfig.address;
            targetWalletTextElement.classList.remove('text-rose-400');
        } else {
            targetWalletTextElement.innerText = `No active address assigned for ${activeNetworkSelection}`;
            targetWalletTextElement.classList.add('text-rose-400');
        }
    }

    function copyTopupWalletToClipboard() {
        const addressTextString = document.getElementById('topupWalletString').innerText;
        if (addressTextString.startsWith("No active") || addressTextString.startsWith("Loading")) return;
        
        navigator.clipboard.writeText(addressTextString)
            .then(() => {
                if (typeof triggerAppAlert === 'function') {
                    triggerAppAlert('Memory Cache Buffered', 'Wallet address copied to clipboard text index.', '📋');
                } else {
                    alert('Copied to clipboard successfully.');
                }
            })
            .catch(err => console.error('Could not run system copy operations:', err));
    }
</script>