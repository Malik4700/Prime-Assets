<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Identity | PRIME ASSETS HOLDINGS 4.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --bg-color: #e2ecf8;
            --neu-light: #ffffff;
            --neu-dark: #7a9fc5;
            --neu-text: #090d16;
            --neu-accent: #f97316;
        }
        body {
            background-color: var(--bg-color);
            color: var(--neu-text);
            font-family: 'Bahnschrift', 'Outfit', sans-serif;
            font-weight: 700;
        }

        /* Neumorphic Design System Styles (Matching Homepage & Plans) */
        .neu-flat {
            background: var(--bg-color);
            box-shadow: 24px 24px 48px #7a9fc5, -24px -24px 48px #ffffff, inset 3px 3px 6px rgba(255,255,255,0.9), inset -3px -3px 6px rgba(122,159,197,0.6);
            border: 2px solid #f97316;
        }
        .neu-pressed {
            background: var(--bg-color);
            box-shadow: inset 10px 10px 20px #7a9fc5, inset -10px -10px 20px #ffffff;
            border: 2px solid #f97316;
        }
        .neu-button {
            background: var(--bg-color);
            box-shadow: 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.9);
            border: 2px solid #f97316;
            transition: all 0.2s ease;
        }
        .neu-button:active {
            box-shadow: inset 8px 8px 16px #7a9fc5, inset -8px -8px 16px #ffffff;
            border-color: #c2410c;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(122,159,197,0.1);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(249, 115, 22, 0.8);
            border-radius: 99px;
        }
    </style>
</head>
<body class="text-[#090d16] min-h-screen flex flex-col font-sans antialiased pb-28 select-none relative overflow-x-hidden custom-scrollbar">

    <!-- Blockade Overlay -->
    <div id="blockadeOverlay" class="<%= (typeof user !== 'undefined' && user && user.isBlocked) ? 'flex' : 'hidden' %> fixed inset-0 bg-slate-950/95 backdrop-blur-xl z-50 flex-col items-center justify-center text-center p-6">
        <div class="w-16 h-16 neu-pressed text-rose-600 border border-rose-500/20 rounded-2xl flex items-center justify-center text-2xl mb-4 shadow-lg animate-pulse font-black">🔒</div>
        <h1 class="text-white font-black text-lg uppercase tracking-widest">Account Restricted</h1>
        <p class="text-slate-400 text-xs max-w-xs mt-1">This hardware node association network link has been suspended by administration security parameters.</p>
    </div>

    <!-- Custom Alert Notification -->
    <div id="customAlert" class="fixed top-6 inset-x-4 max-w-md mx-auto neu-flat border-2 border-[#f97316] rounded-2xl p-4 shadow-2xl z-50 transform translate-y-[-160%] transition-transform duration-500 flex items-start space-x-3">
        <div class="p-2 neu-pressed rounded-xl text-emerald-700 text-lg font-black" id="alertIcon">✨</div>
        <div class="flex-grow">
            <h4 class="text-xs font-black uppercase tracking-wider text-[#090d16]" id="alertTitle">System Message</h4>
            <p class="text-[#121c2e] text-[11px] mt-0.5 leading-relaxed font-black" id="alertMessage">Action logged successfully.</p>
        </div>
        <button onclick="dismissAlert()" class="text-[#121c2e] hover:text-[#090d16] text-base font-black px-1">&times;</button>
    </div>

    <!-- Header -->
    <header class="w-full neu-flat sticky top-0 z-30 px-6 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-2.5">
            <div class="w-14 h-10 neu-pressed rounded-2xl flex items-center justify-center text-emerald-700 font-black text-sm">PAH</div>
            <div>
                <span class="block text-xs font-black tracking-widest text-[#090d16] uppercase leading-none">PRIME ASSETS HOLDINGS 4.0</span>
                <span class="text-[9px] text-emerald-700 font-black uppercase tracking-widest">secure 🔒</span>
            </div>
        </div>
        <span class="text-[9px] neu-pressed rainbow-border text-emerald-700 px-3 py-1.5 rounded-full font-black uppercase tracking-widest animate-pulse">My Profile</span>
    </header>

    <!-- Main Content -->
    <main class="w-full max-w-md mx-auto px-4 pt-6 flex-grow space-y-6">
        
        <!-- Profile Overview Card -->
        <div class="neu-flat border-2 border-[#f97316] rounded-[28px] p-6 shadow-xl flex flex-col items-center text-center relative overflow-hidden">
            <div class="w-20 h-20 mb-3 neu-pressed rounded-2xl border-2 border-[#f97316]/30 flex items-center justify-center text-2xl overflow-hidden shadow-inner">
                <% if (typeof user !== 'undefined' && user && user.profileImage) { %>
                    <img src="<%= user.profileImage %>" class="w-full h-full object-cover" alt="Avatar">
                <% } else { %> 👤 <% } %>
            </div>
            <h3 class="font-black text-base text-[#090d16] tracking-tight mb-1" id="profileNodeUsername">
                <%= (typeof user !== 'undefined' && user) ? user.username : '---' %>
            </h3>
            <span class="neu-pressed text-emerald-700 border border-emerald-500/30 text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-widest shadow-inner">Verified Account 🔰</span>
        </div>

        <!-- Toggle Tabs -->
        <div class="grid grid-cols-2 gap-2 neu-flat border-2 border-[#f97316]/40 p-1.5 rounded-2xl shadow-md">
            <button onclick="toggleIdentityDashboardTab('telemetry')" id="btnTabTelemetry" class="w-full py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all bg-emerald-600 text-white shadow-md">
                My Details 🫆
            </button>
            <button onclick="toggleIdentityDashboardTab('security')" id="btnTabSecurity" class="w-full py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all text-[#121c2e] hover:text-[#090d16]">
                Security Update 🛡️
            </button>
        </div>

        <!-- Telemetry Section -->
        <div id="sectionTabTelemetry" class="neu-flat border-2 border-[#f97316] rounded-[28px] p-5 shadow-xl space-y-3 transition-all duration-300">
            <div class="flex items-center space-x-2 border-b border-[#f97316]/20 pb-2">
                <span class="text-emerald-700">📊</span>
                <h3 class="text-[11px] font-black uppercase tracking-wider text-[#090d16]">Account Details (Secured)</h3>
            </div>
            <div class="divide-y divide-[#f97316]/20 text-xs font-mono font-black">
                <div class="py-3 flex justify-between items-center"><span class="text-[#121c2e] text-[11px]">Username</span><span class="text-[#090d16]" id="telemetryUsername"><%= user.username %></span></div>
                <div class="py-3 flex justify-between items-center"><span class="text-[#121c2e] text-[11px]">Email</span><span class="text-[#090d16] truncate max-w-[200px]" id="telemetryEmail"><%= user.email %></span></div>
                <div class="py-3 flex justify-between items-center"><span class="text-[#121c2e] text-[11px]">Phone</span><span class="text-[#090d16]" id="telemetryPhone"><%= user.phone || '---' %></span></div>
                <div class="py-3 flex justify-between items-center"><span class="text-[#121c2e] text-[11px]">Country</span><span class="text-[#090d16]" id="telemetryCountry"><%= user.country || '---' %></span></div>
                <div class="py-3 flex justify-between items-center"><span class="text-[#121c2e] text-[11px]">Batch Code</span><span class="text-emerald-700" id="telemetryAdminCode"><%= user.assignedAdminCode || '---' %></span></div>
            </div>
        </div>

        <!-- Security Section -->
        <div id="sectionTabSecurity" class="neu-flat border-2 border-[#f97316] rounded-[28px] p-5 shadow-xl space-y-4 hidden transition-all duration-300">
            <div class="flex items-center space-x-2 border-b border-[#f97316]/20 pb-2">
                <span class="text-emerald-700">🛡️</span>
                <h3 class="text-[11px] font-black uppercase tracking-wider text-[#090d16]">Modify Login Key</h3>
            </div>
            <form id="securityCredentialsMutationForm" onsubmit="handleSecurityKeyRotation(event)" class="space-y-3">
                <div class="space-y-1">
                    <label class="block text-[9px] font-black uppercase tracking-wider text-[#121c2e]">Current Login Key</label>
                    <input type="password" required id="oldPasswordInput" class="w-full neu-pressed border-2 border-[#f97316]/30 rounded-xl px-3 py-2.5 text-xs text-[#090d16] focus:outline-none focus:border-[#f97316] font-mono font-black shadow-inner">
                </div>
                <div class="space-y-1">
                    <label class="block text-[9px] font-black uppercase tracking-wider text-[#121c2e]">New Login Key</label>
                    <input type="password" required id="newPasswordInput" class="w-full neu-pressed border-2 border-[#f97316]/30 rounded-xl px-3 py-2.5 text-xs text-[#090d16] focus:outline-none focus:border-[#f97316] font-mono font-black shadow-inner">
                </div>
                <button type="submit" class="w-full neu-button text-emerald-700 font-black text-xs py-3 rounded-xl transition-all uppercase tracking-wider shadow-md mt-2 cursor-pointer">
                    Save New Key
                </button>
            </form>
        </div>

        <!-- Logout Action Button -->
        <div class="space-y-3">
            <button onclick="toggleLogoutModal(true)" class="w-full neu-flat border-2 border-rose-500/40 p-4 rounded-2xl text-left flex items-center justify-between hover:border-rose-500 transition-all shadow-md cursor-pointer">
                <div class="flex items-center space-x-3">
                    <span class="text-xl p-2.5 neu-pressed border border-rose-500/20 text-rose-600 rounded-xl font-black">🚪</span>
                    <div>
                        <h4 class="text-xs font-black text-rose-700 uppercase tracking-wider">LOGOUT</h4>
                        <p class="text-[9px] text-rose-800 mt-0.5 font-mono font-black">Logout of current session</p>
                    </div>
                </div>
                <span class="text-rose-700 font-black text-lg">&rarr;</span>
            </button>
        </div>

        <!-- Logout Confirmation Modal -->
        <div id="customLogoutModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-md transition-all duration-300">
            <div class="neu-flat border-2 border-rose-500 rounded-[32px] p-6 shadow-2xl max-w-xs w-full text-center transform scale-95 transition-transform duration-300">
                <div class="w-12 h-12 mx-auto neu-pressed border border-rose-500/20 text-rose-600 rounded-2xl flex items-center justify-center text-xl mb-4 font-black">⚠️</div>
                
                <h3 class="text-xs font-black tracking-widest text-[#090d16] uppercase mb-2">Confirm Termination</h3>
                <p class="text-[#121c2e] font-mono font-black text-[10px] leading-relaxed mb-6">
                    Terminate account terminal authorization links? You will be signed out of this dashboard environment.
                </p>

                <div class="grid grid-cols-2 gap-2">
                    <button onclick="toggleLogoutModal(false)" class="w-full neu-button text-[#121c2e] font-black text-[10px] py-3 rounded-xl transition-all uppercase tracking-wider">
                        Cancel
                    </button>
                    <a href="/logout" class="w-full neu-button text-rose-700 font-black text-[10px] py-3 rounded-xl transition-all uppercase tracking-wider flex items-center justify-center shadow-md">
                        Disconnect
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- Bottom Navigation Bar with Glassmorphic Round Buttons and Solid Green Active Border -->
    <nav class="fixed bottom-0 inset-x-0 neu-flat px-4 py-3 flex justify-around items-center z-30 shadow-2xl" style="box-shadow: 0 -15px 30px #7a9fc5, 0 15px 30px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.9);">
        
        <!-- Home Button (Glassmorphic Round) -->
        <a href="/user/home" class="flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-[#f97316]/40 text-[#121c2e] hover:text-[#090d16] hover:border-emerald-500 transition-all font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff]">
            <span class="text-lg leading-none">🏠</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Home</span>
        </a>

        <!-- Plans Button (Glassmorphic Round) -->
        <a href="/user/plans" class="flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-[#f97316]/40 text-[#121c2e] hover:text-[#090d16] hover:border-emerald-500 transition-all font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff]">
            <span class="text-lg leading-none">📊</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Plans</span>
        </a>

        <!-- Updates Button (Glassmorphic Round) -->
        <a href="/admin/updates" class="relative flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-[#f97316]/40 text-[#121c2e] hover:text-[#090d16] hover:border-emerald-500 transition-all font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff]">
            <span class="text-lg leading-none">🔔</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Updates</span>
            <% if (typeof hasUnreadUpdates !== 'undefined' && hasUnreadUpdates) { %>
                <span class="absolute top-1 right-2 flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                </span>
            <% } %>
        </a>

        <!-- Profile Button (Active State with Solid Green Border) -->
        <a href="/user/profile" class="flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-emerald-500 text-emerald-700 font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff] transform -translate-y-1 transition-all">
            <span class="text-lg leading-none">👤</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Profile</span>
        </a>
    </nav>

    <!-- Draggable WhatsApp Widget -->
    <div id="draggableWhatsAppWrapper" class="fixed bottom-24 right-6 z-50 touch-none select-none">
        <a href="https://wa.me/923000000000" id="whatsappFloatingLink" target="_blank" class="bg-[#25D366] hover:bg-[#20ba5a] text-white p-3.5 rounded-full shadow-2xl transition-transform duration-200 active:scale-95 flex items-center justify-center cursor-move group" style="box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.004 0C5.378 0 0 5.378 0 12.004c0 2.116.55 4.1 1.608 5.842L0 24l6.337-1.663c1.7.927 3.633 1.42 5.663 1.42 6.628 0 12.004-5.379 12.004-12.005C24.008 5.378 18.63 0 12.004 0zm6.604 17.037c-.27.755-1.564 1.383-2.15 1.436-.58.053-1.164.08-3.76-1.002-3.32-1.382-5.418-4.757-5.584-4.978-.166-.221-1.317-1.754-1.317-3.344 0-1.59.83-2.373 1.127-2.693.297-.32.653-.4.87-.4.218 0 .436 0 .626.01.2.01.466-.075.727.56.27.654.914 2.242.993 2.403.08.16.132.347.026.56-.105.213-.16.347-.318.53-.158.182-.332.406-.475.545-.16.155-.326.326-.14.646.185.32 1.226 2.01 2.636 3.266 1.815 1.616 3.345 2.115 3.812 2.348.467.233.74.214 1.018-.106.278-.32 1.217-1.414 1.543-1.895.327-.48.653-.4.1-.173-.553.226-3.52 1.442-3.834 1.53-.314.087-.522.043-.728-.152-.206-.195-.884-.962-1.07-1.163-.186-.201-.373-.227-.645-.07-.272.156-1.718.71-2.624 1.52-.716.64-1.196 1.418-1.336 1.66-.14.24-.015.37.107.492.11.11.243.284.364.425.122.14.163.24.244.4.082.16.04.3-.02.42-.06.12-.533 1.282-.73 1.755-.19.46-.395.385-.54.377-.14-.007-.3-.008-.46-.008z"/>
            </svg>
        </a>
    </div>

    <script>
        function toggleIdentityDashboardTab(tabName) {
            const tabTelemetry = document.getElementById('sectionTabTelemetry');
            const tabSecurity = document.getElementById('sectionTabSecurity');
            const btnTelemetry = document.getElementById('btnTabTelemetry');
            const btnSecurity = document.getElementById('btnTabSecurity');

            if (tabName === 'telemetry') {
                tabTelemetry.classList.remove('hidden');
                tabSecurity.classList.add('hidden');
                btnTelemetry.className = "w-full py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all bg-emerald-600 text-white shadow-md";
                btnSecurity.className = "w-full py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all text-[#121c2e] hover:text-[#090d16]";
            } else {
                tabTelemetry.classList.add('hidden');
                tabSecurity.classList.remove('hidden');
                btnTelemetry.className = "w-full py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all text-[#121c2e] hover:text-[#090d16]";
                btnSecurity.className = "w-full py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all bg-emerald-600 text-white shadow-md";
            }
        }

        function showAlertNotification(title, message, isError = false) {
            const alertBox = document.getElementById('customAlert');
            const icon = document.getElementById('alertIcon');
            const tEl = document.getElementById('alertTitle');
            const mEl = document.getElementById('alertMessage');

            icon.innerText = isError ? "⚠️" : "✨";
            tEl.innerText = title;
            mEl.innerText = message;

            alertBox.classList.remove('translate-y-[-160%]');
            setTimeout(dismissAlert, 4000);
        }

        function dismissAlert() {
            document.getElementById('customAlert').classList.add('translate-y-[-160%]');
        }
        
        function toggleLogoutModal(shouldOpen) {
            const modalElement = document.getElementById('customLogoutModal');
            if (!modalElement) return;

            if (shouldOpen) {
                modalElement.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            } else {
                modalElement.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }
        
        async function handleSecurityKeyRotation(e) {
            e.preventDefault();
            const oldPassword = document.getElementById('oldPasswordInput').value;
            const newPassword = document.getElementById('newPasswordInput').value;

            try {
                const res = await fetch('/auth/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ oldPassword, newPassword })
                });
                const data = await res.json();
                if (data.success) {
                    showAlertNotification('Success', 'Security access key successfully rotated.');
                    document.getElementById('securityCredentialsMutationForm').reset();
                } else {
                    showAlertNotification('Error', data.message || 'Key rotation rejected.', true);
                }
            } catch (err) {
                showAlertNotification('Network Error', 'Failed to communicate with authentication matrix.', true);
            }
        }

        (function initWhatsAppLinkNetworkSync() {
            const syncWhatsAppEndpoint = () => {
                fetch('/admin/user-sync-data')
                    .then(res => res.json())
                    .then(data => {
                        if (data && data.success && data.whatsappNumber) {
                            const cleanNumber = data.whatsappNumber.toString().trim().replace(/\D/g, '');
                            if (!cleanNumber) return;

                            const elements = document.getElementsByTagName('a');
                            for (let i = 0; i < elements.length; i++) {
                                if (elements[i].href && elements[i].href.includes('wa.me')) {
                                    elements[i].href = "https://wa.me/" + cleanNumber;
                                }
                            }
                        }
                    })
                    .catch(err => console.warn("Identity panel support sync warning:", err));
            };

            syncWhatsAppEndpoint();
            setTimeout(syncWhatsAppEndpoint, 500);
            setTimeout(syncWhatsAppEndpoint, 1500);
        })();

        (function setupDraggableInterface() {
            const item = document.getElementById('draggableWhatsAppWrapper');
            if (!item) return;

            let active = false;
            let currentX, currentY, initialX, initialY;
            let xOffset = 0, yOffset = 0;

            item.addEventListener("touchstart", dragStart, { passive: true });
            document.addEventListener("touchend", dragEnd);
            document.addEventListener("touchmove", drag, { passive: false });
            item.addEventListener("mousedown", dragStart);
            document.addEventListener("mouseup", dragEnd);
            document.addEventListener("mousemove", drag);

            function dragStart(e) {
                let clientX = e.type === "touchstart" ? e.touches[0].clientX : e.clientX;
                let clientY = e.type === "touchstart" ? e.touches[0].clientY : e.clientY;
                initialX = clientX - xOffset;
                initialY = clientY - yOffset;
                if (e.target === item || item.contains(e.target)) active = true;
            }

            function dragEnd() {
                initialX = currentX;
                initialY = currentY;
                active = false;
            }

            function drag(e) {
                if (!active) return;
                if (e.cancelable) e.preventDefault();
                let clientX = e.type === "touchmove" ? e.touches[0].clientX : e.clientX;
                let clientY = e.type === "touchmove" ? e.touches[0].clientY : e.clientY;
                currentX = clientX - initialX;
                currentY = clientY - initialY;
                xOffset = currentX;
                yOffset = currentY;
                item.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
            }
        })();
    </script>
</body>
</html>