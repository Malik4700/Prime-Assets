<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Platform Updates | PRIME ASSETS HOLDINGS 4.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --bg-color: #e2ecf8;
            --neu-light: #ffffff;
            --neu-dark: #7a9fc5;
            --neu-text: #090d16;
            --neu-accent: #f97316;
        }
        body {
            background-color: var(--bg-color);
            color: var(--neu-text);
            font-family: 'Bahnschrift', 'Outfit', sans-serif;
            font-weight: 700;
        }

        /* Neumorphic Design System Styles (Matching Homepage & Plans) */
        .neu-flat {
            background: var(--bg-color);
            box-shadow: 24px 24px 48px #7a9fc5, -24px -24px 48px #ffffff, inset 3px 3px 6px rgba(255,255,255,0.9), inset -3px -3px 6px rgba(122,159,197,0.6);
            border: 2px solid #f97316;
        }
        .neu-pressed {
            background: var(--bg-color);
            box-shadow: inset 10px 10px 20px #7a9fc5, inset -10px -10px 20px #ffffff;
            border: 2px solid #f97316;
        }
        .neu-button {
            background: var(--bg-color);
            box-shadow: 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.9);
            border: 2px solid #f97316;
            transition: all 0.2s ease;
        }
        .neu-button:active {
            box-shadow: inset 8px 8px 16px #7a9fc5, inset -8px -8px 16px #ffffff;
            border-color: #c2410c;
        }

        /* Blessed Glowing Border Animation */
        @keyframes blessedGlow {
            0% { border-color: #10b981; box-shadow: 0 0 15px rgba(16, 185, 129, 0.4), 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff; }
            50% { border-color: #34d399; box-shadow: 0 0 25px rgba(52, 211, 153, 0.7), 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff; }
            100% { border-color: #10b981; box-shadow: 0 0 15px rgba(16, 185, 129, 0.4), 12px 12px 24px #7a9fc5, -12px -12px 24px #ffffff; }
        }
        .blessed-glow-card {
            border: 3px solid #10b981;
            animation: blessedGlow 3s infinite ease-in-out;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(122,159,197,0.1);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(249, 115, 22, 0.8);
            border-radius: 99px;
        }
    </style>
</head>
<body class="text-[#090d16] min-h-screen font-sans antialiased pb-28 custom-scrollbar select-none">

    <!-- Header -->
    <header class="w-full neu-flat sticky top-0 z-30 px-6 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-2.5">
            <div class="w-14 h-10 neu-pressed rounded-2xl flex items-center justify-center text-emerald-700 font-black text-sm">PAH</div>
            <div>
                <span class="block text-xs font-black tracking-widest text-[#090d16] uppercase leading-none">PRIME ASSETS HOLDINGS 4.0</span>
                <span class="text-[9px] text-emerald-700 font-black uppercase tracking-widest">secure 🔒</span>
            </div>
        </div>
        <span class="text-[9px] neu-pressed rainbow-border text-emerald-700 px-3 py-1.5 rounded-full font-black uppercase tracking-widest animate-pulse">Exclusive Updates</span>
    </header>

    <!-- Subtitle Bar inside a Card with Blessed Glowing Border -->
    <div class="max-w-md mx-auto px-4 pt-6">
        <div class="neu-flat blessed-glow-card p-4 rounded-2xl flex items-center space-x-3 shadow-xl">
            <span class="text-lg">🔔</span>
            <h1 class="text-xs font-black tracking-wider uppercase text-[#121c2e] font-mono">collaborated by maritimesupply suite</h1>
        </div>
    </div>

    <!-- Main Content Container -->
    <main class="max-w-md mx-auto p-4 space-y-4 mt-1">
        
        <% if (updates && updates.length > 0) { %>
            <% updates.forEach(item => { %>
                <div class="neu-flat border-2 border-[#f97316] p-5 rounded-[28px] space-y-3 shadow-xl">
                    
                    <% if (item.imageUrl) { %>
                        <div class="w-full rounded-2xl overflow-hidden border-2 border-[#f97316]/30 neu-pressed p-1 shadow-inner">
                            <img src="<%= item.imageUrl %>" alt="System update asset" class="w-full h-auto object-cover max-h-64 rounded-xl" />
                        </div>
                    <% } %>

                    <p class="text-xs text-[#090d16] leading-relaxed font-black whitespace-pre-line">
                        <%- item.text.replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank" class="text-emerald-700 hover:underline break-all font-black">$1</a>') %>
                    </p>

                </div>
            <% }); %>
        <% } else { %>
            <div class="neu-flat border-2 border-[#f97316] p-8 text-center text-xs text-[#121c2e] font-mono rounded-[28px] shadow-xl font-black">
                Stay Tuned For Updates, Coming Soon!
            </div>
        <% } %>

    </main>

    <!-- Bottom Navigation Bar with Glassmorphic Round Buttons and Solid Green Active Border -->
    <nav class="fixed bottom-0 inset-x-0 neu-flat px-4 py-3 flex justify-around items-center z-30 shadow-2xl" style="box-shadow: 0 -15px 30px #7a9fc5, 0 15px 30px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.9);">
        
        <!-- Home Button (Glassmorphic Round) -->
        <a href="/user/home" class="flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-[#f97316]/40 text-[#121c2e] hover:text-[#090d16] hover:border-emerald-500 transition-all font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff]">
            <span class="text-lg leading-none">🏠</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Home</span>
        </a>

        <!-- Plans Button (Glassmorphic Round) -->
        <a href="/user/plans" class="flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-[#f97316]/40 text-[#121c2e] hover:text-[#090d16] hover:border-emerald-500 transition-all font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff]">
            <span class="text-lg leading-none">📊</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Plans</span>
        </a>

        <!-- Updates Button (Active State with Solid Green Border) -->
        <a href="/admin/updates" class="relative flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-emerald-500 text-emerald-700 font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff] transform -translate-y-1 transition-all">
            <span class="text-lg leading-none">🔔</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Updates</span>
            <% if (typeof hasUnreadUpdates !== 'undefined' && hasUnreadUpdates) { %>
                <span class="absolute top-1 right-2 flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                </span>
            <% } %>
        </a>

        <!-- Profile Button (Glassmorphic Round) -->
        <a href="/user/profile" class="flex flex-col items-center justify-center w-14 h-14 rounded-full bg-[#e2ecf8]/70 backdrop-blur-md border-2 border-[#f97316]/40 text-[#121c2e] hover:text-[#090d16] hover:border-emerald-500 transition-all font-black shadow-[4px_4px_10px_#7a9fc5,-4px_-4px_10px_#ffffff]">
            <span class="text-lg leading-none">👤</span>
            <span class="text-[7px] uppercase tracking-wider font-black mt-0.5">Profile</span>
        </a>
    </nav>

</body>
</html>
