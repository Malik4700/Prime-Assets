<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Premium Account | PRIME ASSETS HOLDINGS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --bg-color: #e2ecf8;
            --neu-light: #ffffff;
            --neu-dark: #7a9fc5;
            --neu-text: #090d16;
            --neu-accent: #f97316;
        }
        body {
            background-color: var(--bg-color);
            color: var(--neu-text);
            font-family: 'Bahnschrift', 'Outfit', sans-serif;
            font-weight: 700;
        }

        /* Neumorphic & Glassmorphic Design System Styles */
        .neu-flat {
            background: rgba(226, 236, 248, 0.75);
            backdrop-filter: blur(16px);
            box-shadow: 20px 20px 40px #7a9fc5, -20px -20px 40px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.8), inset -2px -2px 4px rgba(122,159,197,0.4);
            border: 2px solid #f97316;
        }
        .neu-pressed {
            background: rgba(226, 236, 248, 0.85);
            box-shadow: inset 8px 8px 16px #7a9fc5, inset -8px -8px 16px #ffffff;
            border: 2px solid #f97316;
        }
        .neu-button {
            background: var(--bg-color);
            box-shadow: 10px 10px 20px #7a9fc5, -10px -10px 20px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.9);
            border: 2px solid #f97316;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .neu-button:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 14px 14px 28px #7a9fc5, -14px -14px 28px #ffffff, inset 2px 2px 4px rgba(255,255,255,0.9);
            border-color: #10b981;
        }
        .neu-button:active {
            box-shadow: inset 6px 6px 12px #7a9fc5, inset -6px -6px 12px #ffffff;
            transform: translateY(1px) scale(0.98);
        }

        /* 9D Hovering Card Effect */
        .hover-9d {
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
        }
        .hover-9d:hover {
            transform: translateY(-6px) scale(1.01) perspective(1000px) rotateX(1deg) rotateY(-1deg);
            box-shadow: 30px 30px 60px #7a9fc5, -30px -30px 60px #ffffff, inset 3px 3px 6px rgba(255,255,255,0.9);
        }

        @keyframes gradientFlow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .animate-gradient-text {
            background-size: 200% auto;
            animation: gradientFlow 4s linear infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between font-sans relative overflow-x-hidden antialiased select-none">

    <!-- Fireworks Canvas for On-Screen Greeting Welcome -->
    <canvas id="fireworksCanvas" class="absolute inset-0 w-full h-full pointer-events-none z-40 transition-opacity duration-1000 ease-out"></canvas>

    <!-- Header matching previous files -->
    <header class="w-full neu-flat sticky top-0 z-30 px-6 py-4 flex justify-between items-center shadow-md border-b-2 border-[#f97316]">
        <div class="flex items-center space-x-2.5">
            <div class="w-14 h-10 neu-pressed rounded-2xl flex items-center justify-center text-emerald-700 font-black text-sm">PAH</div>
            <div>
                <span class="block text-xs font-black tracking-widest text-[#090d16] uppercase leading-none">PRIME ASSETS HOLDINGS 4.0</span>
                <span class="text-[9px] text-emerald-700 font-black uppercase tracking-widest">secure 🔒</span>
            </div>
        </div>
        <span class="text-[9px] neu-pressed text-emerald-700 px-3 py-1.5 rounded-full font-black uppercase tracking-widest shadow-inner">Create Account</span>
    </header>

    <main class="flex-grow flex flex-col items-center justify-center p-4 sm:p-6 z-10 space-y-4">
        <a href="/" class="neu-button text-[#121c2e] hover:text-emerald-700 text-xs font-black uppercase tracking-widest py-2.5 px-6 rounded-2xl transition-all duration-200">
            &larr; Home
        </a>

        <div class="neu-flat hover-9d p-6 sm:p-8 rounded-[2.5rem] max-w-lg w-full group">
            
            <div class="mb-5 text-center">
                <h1 class="text-3xl sm:text-4xl font-black tracking-tight mb-2 bg-gradient-to-r from-emerald-700 via-teal-600 to-indigo-700 bg-clip-text text-transparent animate-gradient-text filter drop-shadow-sm">
                    Get Started
                </h1>
                <p class="text-[10px] text-emerald-700 font-black tracking-widest uppercase">Create your isolated user workspace account</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="neu-pressed border-2 border-rose-500/40 text-rose-700 text-xs py-3 px-4 rounded-2xl mb-4 text-center tracking-wide font-black shadow-inner">
                    <%= error %>
                </div>
            <% } %>

            <form action="/auth/signup" method="POST" class="space-y-4">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-black uppercase text-[#121c2e] tracking-wider mb-1.5 pl-1">Username</label>
                        <input type="text" name="username" required placeholder="johndoe"
                               class="w-full neu-pressed border-2 border-[#f97316]/40 rounded-2xl px-4 py-3 text-sm text-[#090d16] placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 font-bold">
                    </div>
                    <div>
                        <label class="block text-[11px] font-black uppercase text-[#121c2e] tracking-wider mb-1.5 pl-1">Email Address</label>
                        <input type="email" name="email" required placeholder="name@example.com"
                               class="w-full neu-pressed border-2 border-[#f97316]/40 rounded-2xl px-4 py-3 text-sm text-[#090d16] placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 font-bold">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-black uppercase text-[#121c2e] tracking-wider mb-1.5 pl-1">Phone Number</label>
                        <input type="text" name="phone" required placeholder="+1 (555) 000-0000"
                               class="w-full neu-pressed border-2 border-[#f97316]/40 rounded-2xl px-4 py-3 text-sm text-[#090d16] placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 font-bold">
                    </div>
                    <div>
                        <label class="block text-[11px] font-black uppercase text-[#121c2e] tracking-wider mb-1.5 pl-1">Country</label>
                        <input type="text" name="country" required placeholder="United States"
                               class="w-full neu-pressed border-2 border-[#f97316]/40 rounded-2xl px-4 py-3 text-sm text-[#090d16] placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 font-bold">
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-black uppercase text-[#121c2e] tracking-wider mb-1.5 pl-1">Gender</label>
                    <div class="relative">
                        <select name="gender" required 
                                class="w-full neu-pressed border-2 border-[#f97316]/40 rounded-2xl px-4 py-3 text-sm text-[#090d16] focus:outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 appearance-none cursor-pointer font-bold">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-[#121c2e]">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-black uppercase text-[#121c2e] tracking-wider mb-1.5 pl-1">Password</label>
                        <div class="relative">
                            <input type="password" id="password" name="password" required placeholder="••••••••"
                                   class="w-full neu-pressed border-2 border-[#f97316]/40 rounded-2xl pl-4 pr-12 py-3 text-sm text-[#090d16] placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 font-bold">
                            
                            <button type="button" onclick="togglePassword('password', 'eyeOpenPass', 'eyeClosedPass')" class="absolute right-4 top-1/2 -translate-y-1/2 text-[#121c2e] hover:text-emerald-700 focus:outline-none transition-colors duration-200">
                                <svg id="eyeOpenPass" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                                <svg id="eyeClosedPass" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.025 10.025 0 014.132-5.4M9.9 4.24a9.122 9.122 0 012.1-.24c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.4M9.9 4.24L1.5 1.5M22.5 22.5L13.875 13.875M12 9a3 3 0 00-3 3" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-[11px] font-black uppercase text-[#121c2e] tracking-wider mb-1.5 pl-1">Verify Password</label>
                        <div class="relative">
                            <input type="password" id="verifyPassword" name="verifyPassword" required placeholder="••••••••"
                                   class="w-full neu-pressed border-2 border-[#f97316]/40 rounded-2xl pl-4 pr-12 py-3 text-sm text-[#090d16] placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all duration-300 font-bold">
                            
                            <button type="button" onclick="togglePassword('verifyPassword', 'eyeOpenVerify', 'eyeClosedVerify')" class="absolute right-4 top-1/2 -translate-y-1/2 text-[#121c2e] hover:text-emerald-700 focus:outline-none transition-colors duration-200">
                                <svg id="eyeOpenVerify" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                                <svg id="eyeClosedVerify" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.025 10.025 0 014.132-5.4M9.9 4.24a9.122 9.122 0 012.1-.24c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.4M9.9 4.24L1.5 1.5M22.5 22.5L13.875 13.875M12 9a3 3 0 00-3 3" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="pt-1">
                    <label class="block text-[11px] font-black uppercase text-amber-700 tracking-wider mb-1.5 pl-1">Onboarding Promo Code</label>
                    <input type="text" name="promoCode" required placeholder="Enter PROMO/Referral Code" 
                           class="w-full neu-pressed border-2 border-amber-500 rounded-2xl px-4 py-3 text-sm text-[#090d16] placeholder-amber-700/50 focus:outline-none focus:border-amber-600 focus:ring-4 focus:ring-amber-500/10 transition-all duration-300 font-mono tracking-wider uppercase font-bold">
                </div>

                <div class="pt-2">
                    <button type="submit" 
                            class="w-full neu-button text-emerald-700 font-black py-3.5 px-4 rounded-2xl text-xs uppercase tracking-widest transition-all duration-300">
                        Register Account
                    </button>
                </div>
            </form>

            <div class="mt-5 text-center text-xs text-[#121c2e] font-black tracking-wide">
                Already have an account? <a href="/auth/login" class="text-emerald-700 hover:text-emerald-800 hover:underline font-black transition-colors duration-150 pl-1 uppercase">Login</a>
            </div>
        </div>
    </main>

    <footer class="text-center py-5 text-[10px] text-[#121c2e] font-black tracking-widest border-t-2 border-[#f97316]/40 z-10 neu-flat uppercase">
        &copy; 2026 PRIME ASSETS HOLDINGS &bull; RESOURCE MANAGEMENT ENGINE &bull; ALL RIGHTS RESERVED
    </footer>

    <script>
        function togglePassword(inputId, openIconId, closedIconId) {
            const inputField = document.getElementById(inputId);
            const eyeOpen = document.getElementById(openIconId);
            const eyeClosed = document.getElementById(closedIconId);
            if (inputField.type === "password") { inputField.type = "text"; eyeOpen.classList.add('hidden'); eyeClosed.classList.remove('hidden'); }
            else { inputField.type = "password"; eyeOpen.classList.remove('hidden'); eyeClosed.classList.add('hidden'); }
        }
    </script>

    <script>
        const fwCanvas = document.getElementById('fireworksCanvas');
        const fwCtx = fwCanvas.getContext('2d');
        let fwActive = true;
        function resizeFwCanvas() { fwCanvas.width = window.innerWidth; fwCanvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeFwCanvas); resizeFwCanvas();

        let particles = [];
        const colors = ['#10b981', '#06b6d4', '#3b82f6', '#f97316', '#6366f1', '#ec4899'];

        class Particle {
            constructor(x, y, color) {
                this.x = x; this.y = y; this.color = color;
                this.radius = Math.random() * 3 + 1;
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 6 + 2;
                this.vx = Math.cos(angle) * speed;
                this.vy = Math.sin(angle) * speed;
                this.alpha = 1;
                this.decay = Math.random() * 0.015 + 0.015;
            }
            draw() {
                fwCtx.save(); fwCtx.globalAlpha = this.alpha; fwCtx.beginPath();
                fwCtx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                fwCtx.fillStyle = this.color; fwCtx.fill(); fwCtx.restore();
            }
            update() { this.x += this.vx; this.y += this.vy; this.vy += 0.05; this.alpha -= this.decay; }
        }

        function spawnFirework() {
            if (!fwActive) return;
            const x = Math.random() * fwCanvas.width;
            const y = Math.random() * (fwCanvas.height * 0.6);
            const color = colors[Math.floor(Math.random() * colors.length)];
            for (let i = 0; i < 40; i++) { particles.push(new Particle(x, y, color)); }
        }

        let fireworkTimer = setInterval(spawnFirework, 350);

        function animateFireworks() {
            if (!fwActive && particles.length === 0) return;
            fwCtx.clearRect(0, 0, fwCanvas.width, fwCanvas.height);

            if (fwActive) {
                fwCtx.save(); 
                fwCtx.font = "900 2.5rem 'Bahnschrift', sans-serif"; 
                fwCtx.textAlign = "center";
                let gradient = fwCtx.createLinearGradient(fwCanvas.width/2 - 120, 0, fwCanvas.width/2 + 120, 0);
                gradient.addColorStop(0, '#047857'); 
                gradient.addColorStop(1, '#f97316');
                fwCtx.fillStyle = gradient; 
                fwCtx.fillText("Welcome!", fwCanvas.width / 2, fwCanvas.height * 0.2);
                fwCtx.restore();
            }

            particles.forEach((p, i) => {
                p.update(); p.draw();
                if (p.alpha <= 0) particles.splice(i, 1);
            });
            requestAnimationFrame(animateFireworks);
        }
        animateFireworks();

        setTimeout(() => {
            fwActive = false;
            clearInterval(fireworkTimer);
            fwCanvas.style.opacity = '0';
            setTimeout(() => {
                fwCanvas.remove();
            }, 1000);
        }, 3000);
    </script>
</body>
</html>