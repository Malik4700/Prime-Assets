<div>
<div class="flex flex-col md:flex-row justify-between items-start md:items-center bg-slate-50 border p-6 rounded-2xl gap-4" onclick="event.stopPropagation()">            <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider">Plans Management Desk</h3>
            <p class="text-[11px] text-slate-400 font-medium mt-0.5">Approve, monitor, suspend, or continue active ledger tier running operations inside your code cluster.</p>
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto">
            <div class="relative w-full md:w-64">
                <input type="text" id="adminPlansDeskSearchInput" oninput="applyAdminPlansSearchFilter()" autocomplete="new-password" name="prevent_autofill_search" placeholder="Search username or email..." class="w-full bg-white border text-xs font-medium px-3.5 py-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900/10 placeholder-slate-400 text-slate-700">
            </div>
            <button onclick="reloadPlansManagementDesk()" class="bg-slate-900 text-white font-black text-[10px] uppercase tracking-wider px-4 py-2.5 rounded-xl shadow-sm transition-transform active:scale-95 whitespace-nowrap">
                Sync Ledger Streams 🔄
            </button>
        </div>
    </div>

    <div class="bg-white border rounded-2xl overflow-hidden shadow-sm mt-6">
        <div class="p-4 border-b bg-slate-50/50">
            <h4 class="font-black text-slate-800 text-[11px] uppercase tracking-wider">Pending Activation Queue</h4>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b bg-slate-50 text-[9px] font-black uppercase tracking-wider text-slate-400">
                        <th class="py-3.5 px-6">Subscriber Handle</th>
                        <th class="py-3.5 px-4">Workspace Balance</th>
                        <th class="py-3.5 px-4">Requested Premium Tier</th>
                        <th class="py-3.5 px-4">Verification Actions</th>
                    </tr>
                </thead>
                <tbody id="adminPendingPlansQueueTableBody" class="divide-y text-xs font-medium text-slate-700">
                    </tbody>
            </table>
        </div>
    </div>

    <div class="bg-white border rounded-2xl overflow-hidden shadow-sm mt-6">
        <div class="p-4 border-b bg-slate-50/50">
            <h4 class="font-black text-slate-800 text-[11px] uppercase tracking-wider">Active Run Portfolio Distribution Grid</h4>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b bg-slate-50 text-[9px] font-black uppercase tracking-wider text-slate-400">
                        <th class="py-3.5 px-6">Subscriber Identity</th>
                        <th class="py-3.5 px-4">Plan Designation</th>
                        <th class="py-3.5 px-4">Current Balance</th>
                        <th class="py-3.5 px-4">Engine State</th>
                        <th class="py-3.5 px-4">Time Horizon Milestone</th>
                        <th class="py-3.5 px-4 text-right px-6">Runtime Directive Controls</th>
                    </tr>
                </thead>
                <tbody id="adminActivePlansDistributionTableBody" class="divide-y text-xs font-medium text-slate-700">
                    </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    let CACHED_ALL_SUBSCRIBERS_PLANS_DATA = [];

    document.addEventListener("DOMContentLoaded", () => {
        reloadPlansManagementDesk();
    });

    function reloadPlansManagementDesk() {
        fetch('/admin/api/users-plans-queue')
            .then(res => res.json())
            .then(usersList => {
                CACHED_ALL_SUBSCRIBERS_PLANS_DATA = usersList;
                applyAdminPlansSearchFilter();
            })
            .catch(err => {
                console.error("Dashboard tracking desk feed interrupt:", err);
            });
    }

    function applyAdminPlansSearchFilter() {
        const query = document.getElementById('adminPlansDeskSearchInput').value.trim().toLowerCase();
        
        const filtered = CACHED_ALL_SUBSCRIBERS_PLANS_DATA.filter(u => {
            const username = (u.username || '').toLowerCase();
            const email = (u.email || '').toLowerCase();
            return username.includes(query) || email.includes(query);
        });

        const pendingList = filtered.filter(u => u.planRequestStatus === 'pending');
        const activeList = filtered.filter(u => u.currentPlan && u.currentPlan !== 'None');

        renderPendingPlansQueueTable(pendingList);
        renderActivePlansGridTable(activeList);
    }

    function renderPendingPlansQueueTable(usersList) {
        const tableBody = document.getElementById('adminPendingPlansQueueTableBody');
        tableBody.innerHTML = '';

        if (usersList.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="4" class="text-center py-8 text-slate-400 font-normal text-xs uppercase tracking-wider">No active pending buy logs inside this administrative partition</td>
                </tr>
            `;
            return;
        }

        usersList.forEach(user => {
            const tr = document.createElement('tr');
            tr.className = "hover:bg-slate-50/50 transition-colors";

            // Determine badge style based on plan type
            const isPromo = user.requestedPlanName && user.requestedPlanName.startsWith('PROMO:');
            const badgeClass = isPromo 
                ? "bg-amber-500 text-white border-amber-600" 
                : "bg-amber-50 text-amber-700 border-amber-200";

            tr.innerHTML = `
                <td class="py-4 px-6">
                    <p class="font-black text-slate-900">${user.username}</p>
                    <p class="text-[10px] text-slate-400 mt-0.5">${user.email}</p>
                </td>
                <td class="py-4 px-4 font-bold text-slate-800">$${parseFloat(user.balance || 0).toFixed(2)}</td>
                <td class="py-4 px-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-black uppercase tracking-wider border shadow-sm ${badgeClass}">
                        ${user.requestedPlanName || 'Subscription'}
                    </span>
                    <p class="text-[9px] text-slate-400 font-black tracking-widest mt-1">HOLD FEE: $${parseFloat(user.requestedPlanCost || 0).toFixed(2)}</p>
                </td>
                <td class="py-4 px-4">
                    <div class="flex items-center gap-2">
                        <button onclick="executePlanActionCommit('${user._id}', 'approve')" class="bg-emerald-600 hover:bg-emerald-700 text-white text-[9px] font-black uppercase tracking-wider px-3 py-2 rounded-xl shadow-sm transition-transform active:scale-95">Approve Order</button>
                        <button onclick="executePlanActionCommit('${user._id}', 'reject')" class="bg-rose-50 hover:bg-rose-100 text-rose-600 text-[9px] font-black uppercase tracking-wider px-3 py-2 rounded-xl border border-rose-200 transition-transform active:scale-95">Decline</button>
                    </div>
                </td>
            `;
            tableBody.appendChild(tr);
        });
    }

    function renderActivePlansGridTable(usersList) {
        const tableBody = document.getElementById('adminActivePlansDistributionTableBody');
        tableBody.innerHTML = '';

        if (usersList.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-8 text-slate-400 font-normal text-xs uppercase tracking-wider">No active ongoing plans associated with users in this block cluster</td>
                </tr>
            `;
            return;
        }

        usersList.forEach(user => {
            const tr = document.createElement('tr');
            tr.className = "hover:bg-slate-50/50 transition-colors";

            let timeHorizonStr = `<span class="text-slate-400 font-normal">No Expiration Timestamp Set</span>`;
            if (user.planExpiresAt) {
                const dateObj = new Date(user.planExpiresAt);
                timeHorizonStr = `<p class="font-bold text-slate-800 text-[11px]">${dateObj.toLocaleDateString()}</p><p class="text-[9px] font-black text-slate-400 uppercase tracking-wider mt-0.5">${dateObj.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</p>`;
            }

            // Fixed: Check user.isPlanPaused to style the status indicators accurately
            const isPaused = user.isPlanPaused === true || user.isPlanPaused === 'true';
            const statusBadge = isPaused 
                ? `<span class="inline-flex items-center px-2 py-0.5 rounded-md text-[9px] font-black bg-rose-50 border border-rose-200 text-rose-600 uppercase tracking-wider animate-pulse">PAUSED / HALTED</span>` 
                : `<span class="inline-flex items-center px-2 py-0.5 rounded-md text-[9px] font-black bg-emerald-50 border border-emerald-200 text-emerald-600 uppercase tracking-wider">LIVE YIELD TICKING</span>`;

            const toggleButton = isPaused
                ? `<button onclick="executeActivePlanToggle('${user._id}', 'continue')" class="bg-emerald-600 hover:bg-emerald-700 text-white text-[9px] font-black uppercase tracking-wider px-3 py-2 rounded-xl shadow-sm transition-transform active:scale-95">CONTINUE ENGINE</button>`
                : `<button onclick="executeActivePlanToggle('${user._id}', 'stop')" class="bg-slate-900 hover:bg-slate-800 text-white text-[9px] font-black uppercase tracking-wider px-3 py-2 rounded-xl shadow-sm transition-transform active:scale-95">STOP ENGINE</button>`;

            tr.innerHTML = `
                <td class="py-4 px-6">
                    <p class="font-black text-slate-900">${user.username}</p>
                    <p class="text-[10px] text-slate-400 mt-0.5">${user.email}</p>
                </td>
                <td class="py-4 px-4 font-black uppercase tracking-widest text-slate-500 text-[11px]">${user.currentPlan} Days Tier</td>
                <td class="py-4 px-4 font-bold text-slate-800">$${parseFloat(user.balance || 0).toFixed(4)}</td>
                <td class="py-4 px-4">${statusBadge}</td>
                <td class="py-4 px-4">${timeHorizonStr}</td>
                <td class="py-4 px-6 text-right">
                    <div class="flex items-center justify-end gap-2">
                        ${toggleButton}
                    </div>
                </td>
            `;
            tableBody.appendChild(tr);
        });
    }

    function executePlanActionCommit(userId, action, planDays) {
        fetch('/admin/plans/action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId, action, planDays })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (typeof showNotification === 'function') {
                    showNotification('Success', data.msg);
                } else {
                    alert(data.msg);
                }
                reloadPlansManagementDesk();
            } else {
                if (typeof showNotification === 'function') {
                    showNotification('Error', data.msg || 'Transaction rejected.', 'error');
                } else {
                    alert(data.msg || 'Error processing command');
                }
            }
        })
        .catch(() => {
            if (typeof showNotification === 'function') {
                showNotification('Network Failure', 'Lost terminal synchronization with backend layer endpoint pipeline.', 'error');
            } else {
                alert('Network operational failure');
            }
        });
    }

    function executeActivePlanToggle(userId, command) {
        fetch('/admin/plans/toggle-engine-state', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId, command })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (typeof showNotification === 'function') {
                    showNotification('Engine Synchronized', data.msg);
                } else {
                    alert(data.msg);
                }
                reloadPlansManagementDesk();
            } else {
                alert(data.msg || 'Error modifying core yield runtime state.');
            }
        })
        .catch(() => {
            alert('Lost pipeline connection with administrative router nodes.');
        });
    }
</script>