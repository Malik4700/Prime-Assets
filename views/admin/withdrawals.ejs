<script>
    function filterDepositHistoryLogsByTxid() {
        const query = document.getElementById('depositTxidHistorySearchField').value.toLowerCase();
        const rows = document.querySelectorAll('.target-deposit-row');
        rows.forEach(row => {
            const hashCell = row.querySelector('.hash-string-cell');
            if (hashCell) {
                const text = hashCell.textContent || hashCell.innerText;
                row.style.display = text.toLowerCase().includes(query) ? '' : 'none';
            }
        });
    }

    function filterWithdrawalHistoryLogs() {
        const query = document.getElementById('withdrawalHistorySearchField').value.toLowerCase();
        const rows = document.querySelectorAll('.target-withdrawal-row');
        rows.forEach(row => {
            const coordinateCell = row.querySelector('.coordinate-string-cell');
            if (coordinateCell) {
                const text = coordinateCell.textContent || coordinateCell.innerText;
                row.style.display = text.toLowerCase().includes(query) ? '' : 'none';
            }
        });
    }
</script>

<script>
    // Tab Controller Switches Layout States
    function toggleFinanceTab(targetPanelId, activeBtn) {
        document.querySelectorAll('.finance-panel-view').forEach(panel => panel.classList.replace('block', 'hidden'));
        document.getElementById(targetPanelId).classList.replace('hidden', 'block');

        document.querySelectorAll('.finance-tab-btn').forEach(btn => {
            btn.classList.remove('border-indigo-600', 'text-indigo-600', 'font-black');
            btn.classList.add('border-transparent', 'text-slate-400', 'font-bold');
        });
        activeBtn.classList.replace('border-transparent', 'border-indigo-600');
        activeBtn.classList.replace('text-slate-400', 'text-indigo-600');
        activeBtn.classList.replace('font-bold', 'font-black');

        if(targetPanelId === 'deposit-wallets-panel') {
            pollConfiguredGatewayWallets();
        }
    }

    // Load Wallet Configuration Grid Details
    async function pollConfiguredGatewayWallets() {
        const streamBox = document.getElementById('activeGatewayWalletsListStreamBox');
        try {
            const response = await fetch('/admin/finance/gateways');
            if (!response.ok) throw new Error("Repository network stream broken.");
            const accounts = await response.json();

            if (accounts.length === 0) {
                streamBox.innerHTML = `
                    <tr>
                        <td colspan="3" class="text-center py-8 text-slate-400 font-medium text-[11px] uppercase tracking-wider">No active address assignments written to database records.</td>
                    </tr>
                `;
                return;
            }

            streamBox.innerHTML = '';
            accounts.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/50 transition-colors";
                tr.innerHTML = `
                    <td class="py-3 font-mono font-black text-slate-900">${escapeHtmlMarkup(item.blockchain)}</td>
                    <td class="py-3 font-mono text-slate-500 tracking-tight break-all select-all pr-4">${escapeHtmlMarkup(item.address)}</td>
                    <td class="py-3 text-right space-x-2 shrink-0">
                        <button onclick="stagedGatewayEditRecord('${item._id}', '${escapeHtmlMarkup(item.blockchain)}', '${escapeHtmlMarkup(item.address)}')" class="text-indigo-600 hover:text-indigo-800 font-black text-[10px] uppercase tracking-wider">Edit</button>
                        <button onclick="commitGatewayRemovalOrder('${item._id}')" class="text-rose-600 hover:text-rose-800 font-black text-[10px] uppercase tracking-wider">Delete</button>
                    </td>
                `;
                streamBox.appendChild(tr);
            });
        } catch (err) {
            console.error("Failed to load gateway accounts:", err);
            streamBox.innerHTML = `<tr><td colspan="3" class="text-center py-6 text-rose-500 font-bold uppercase">Database Grid Synchronization Error</td></tr>`;
        }
    }

    // Submit New or Modified Wallet Entry Actions
    async function commitGatewayConfigurationOrder(event) {
        event.preventDefault();
        const editingId = document.getElementById('editingGatewayRecordId').value;
        const blockchain = document.getElementById('gatewayBlockchainSelector').value;
        const address = document.getElementById('gatewayPublicStringAddressField').value.trim();

        if(!address) return;

        try {
            const endpoint = editingId ? `/admin/finance/update-gateway/${editingId}` : '/admin/finance/create-gateway';
            const requestMethod = editingId ? 'PUT' : 'POST';
            
            const response = await fetch(endpoint, {
                method: requestMethod,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ blockchain, address })
            });

            const resData = await response.json();
            if(response.ok && resData.success) {
                if (typeof showNotification !== 'undefined') {
                    showNotification('Database State Altered', resData.msg || 'Configuration updated.', 'success');
                } else { alert(resData.msg || 'Saved.'); }
                clearWalletConfigurationForm();
                pollConfiguredGatewayWallets();
            } else {
                alert(resData.msg || "Operation rejected by database controllers.");
            }
        } catch(err) {
            console.error("Configuration tracking post error:", err);
        }
    }

    // Trigger Edit Stage Configuration States
    function stagedGatewayEditRecord(id, blockchain, address) {
        document.getElementById('editingGatewayRecordId').value = id;
        document.getElementById('gatewayBlockchainSelector').value = blockchain;
        document.getElementById('gatewayPublicStringAddressField').value = address;
        document.getElementById('submitFormOperationActionBtn').innerText = "Update Wallet Coordinates";
        document.getElementById('resetFormInterfaceStateCancelBtn').classList.remove('hidden');
    }

    // Clear and Reset Form Parameters
    function clearWalletConfigurationForm() {
        document.getElementById('editingGatewayRecordId').value = '';
        document.getElementById('gatewayPublicStringAddressField').value = '';
        document.getElementById('submitFormOperationActionBtn').innerText = "Save Destination Address";
        document.getElementById('resetFormInterfaceStateCancelBtn').classList.add('hidden');
    }

    // Delete Configuration Entry Record
    async function commitGatewayRemovalOrder(id) {
        if(!confirm("Permanently strip this wallet architecture profile target address configuration from your subscriber displays?")) return;
        try {
            const response = await fetch(`/admin/finance/delete-gateway/${id}`, { method: 'DELETE' });
            const resData = await response.json();
            if(response.ok && resData.success) {
                if (typeof showNotification !== 'undefined') {
                    showNotification('Record Cleared', 'Destination parameter purged.', 'success');
                }
                pollConfiguredGatewayWallets();
            } else {
                alert(resData.msg || "Delete transaction rejected.");
            }
        } catch(err) {
            console.error("Purging channel connection error:", err);
        }
    }

    function escapeHtmlMarkup(str) {
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    // CORE TRANSACTION DISPATCH SETTLED METHOD (Untouched - Original code logic pipeline preserved)
    async function commitSettlementAction(withdrawalId, actionType) {
        if (!confirm(`Are you sure you want to execute [${actionType.toUpperCase()}] on this withdrawal ticket request transaction? Notice: A $2 fee will be deducted under withdraw policy (Not applicable for beginner plan buyers) `)) return;
        
        try {
            const response = await fetch(`/admin/withdrawals/${actionType}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ withdrawalId })
            });
            
            const result = await response.json();
            
            if (response.ok && result.success) {
                if (typeof showNotification !== 'undefined') {
                    showNotification(
                        actionType === 'approve' ? 'Settled Successfully' : 'Bounced Back', 
                        result.msg, 
                        actionType === 'approve' ? 'success' : 'error'
                    );
                } else {
                    alert(result.msg);
                }
                
                const targetRow = document.getElementById(`withdrawal-row-${withdrawalId}`);
                if (targetRow) {
                    targetRow.style.opacity = '0.3';
                    targetRow.style.pointerEvents = 'none';
                }
                setTimeout(() => window.location.reload(), 1200);
            } else {
                if (typeof showNotification !== 'undefined') {
                    showNotification('Pipeline Exception', result.msg || 'Action could not be executed.', 'error');
                } else {
                    alert(result.msg || 'Execution failure.');
                }
            }
        } catch (err) {
            console.error('Settlement transmission error:', err);
            if (typeof showNotification !== 'undefined') {
                showNotification('Network Channel Error', 'Request failed down the routing track.', 'error');
            } else {
                alert('Network request execution failure.');
            }
        }
    }

