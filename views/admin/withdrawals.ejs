<div class="flex items-center space-x-2 border-b border-slate-200 mb-6 pb-px">
    <button onclick="toggleFinanceTab('requests-tab-panel', this)" class="finance-tab-btn border-b-2 border-indigo-600 px-4 py-2.5 text-xs font-black uppercase tracking-wider text-indigo-600 focus:outline-none transition-all">
        Pending Cashout Requests
    </button>
    <button onclick="toggleFinanceTab('deposit-proofs-panel', this)" class="finance-tab-btn border-b-2 border-transparent px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-400 hover:text-slate-600 focus:outline-none transition-all">
        Pending Deposit Proofs
    </button>
    <button onclick="toggleFinanceTab('deposit-wallets-panel', this)" class="finance-tab-btn border-b-2 border-transparent px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-400 hover:text-slate-600 focus:outline-none transition-all">
        Deposit Management
    </button>
</div>

<div id="requests-tab-panel" class="finance-panel-view block space-y-4">
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div>
                <h3 class="font-black text-lg text-slate-900 mb-1">Pending Cashout Requests</h3>
                <p class="text-xs text-slate-400 font-medium">Authorize or reject processing requests submitted by tenants.</p>
            </div>
            <div class="bg-indigo-50 border border-indigo-100 rounded-xl px-3 py-1.5 text-right flex items-center space-x-2">
                <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
                <span class="text-[10px] font-black uppercase text-indigo-700 tracking-wider">Settlement Ledger Node</span>
            </div>
        </div>

        <% if (typeof pendingWithdrawals !== 'undefined' && pendingWithdrawals.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="border-b border-slate-100 text-slate-400 font-bold uppercase tracking-wider">
                            <th class="pb-3 font-semibold">User Profile Identity</th>
                            <th class="pb-3 font-semibold">Target Network Coordinates</th>
                            <th class="pb-3 font-semibold">Volume (USD)</th>
                            <th class="pb-3 font-semibold">Submission Timestamp</th>
                            <th class="pb-3 text-right font-semibold">Action Control Intercepts</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 font-medium text-slate-700">
    <% pendingWithdrawals.forEach(item => { %>
        <tr id="withdrawal-row-<%= item._id %>" class="hover:bg-slate-50/50 transition-colors">
            <td class="py-3.5">
                <span class="block font-black uppercase text-slate-900 tracking-tight">
                    <%= (item.userId && item.userId.username) ? item.userId.username : 'Anonymous Node' %>
                </span>
                <span class="text-[10px] text-slate-400 select-all">
                    <%= (item.userId && item.userId.email) ? item.userId.email : '' %>
                </span>
            </td>
            <td class="py-3.5 font-mono">
                <span class="inline-block bg-slate-100 px-1.5 py-0.5 rounded text-[10px] font-bold text-slate-600 mb-0.5">
                    <%= item.method || item.blockchain || 'Blockchain Network' %>
                </span>
                <span class="block text-[11px] text-slate-500 tracking-tight max-w-[200px] truncate select-all" title="<%= item.address %>"><%= item.address %></span>
            </td>
            <td class="py-3.5 font-mono text-slate-900 font-bold text-sm">
                $<%= parseFloat(item.amount || 0).toFixed(2) %>
            </td>
            <td class="py-3.5 text-slate-400 text-[11px]">
                <%= new Date(item.createdAt || Date.now()).toLocaleString() %>
            </td>
            <td class="py-3.5 text-right space-x-1 shrink-0">
                <button onclick="commitSettlementAction('<%= item._id %>', 'reject')" class="bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-600 font-black text-[10px] uppercase tracking-wider px-3 py-2 rounded-xl transition-all active:scale-95">Bounce</button>
                <button onclick="commitSettlementAction('<%= item._id %>', 'approve')" class="bg-emerald-600 hover:bg-emerald-500 text-white font-black text-[10px] uppercase tracking-wider px-4 py-2 rounded-xl shadow-sm transition-all active:scale-95">Settle Request</button>
            </td>
        </tr>
    <% }) %>
</tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-12 border border-dashed border-slate-200 rounded-2xl bg-slate-50/40">
                <span class="text-3xl block">📥</span>
                <h4 class="font-black text-slate-800 text-xs uppercase tracking-wider mt-3">Roster Settled</h4>
                <p class="text-slate-400 text-[11px] mt-0.5 max-w-xs mx-auto">No pending outbound capital remittances have been registered down pipeline lines.</p>
            </div>
        <% } %>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm mt-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
            <div>
                <h3 class="font-black text-lg text-slate-900 mb-1">Withdrawal Logs History</h3>
                <p class="text-xs text-slate-400 font-medium">Historical audit stream of completely processed and cleared payout instances.</p>
            </div>
            <div class="flex items-center space-x-3">
                <input type="text" id="withdrawalHistorySearchField" onkeyup="filterWithdrawalHistoryLogs()" placeholder="Search target address..." class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-medium text-slate-800 focus:outline-none focus:ring-1 focus:ring-indigo-500 min-w-[200px]">
                <div class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-right flex items-center space-x-2 shrink-0">
                    <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                    <span class="text-[10px] font-black uppercase text-slate-600 tracking-wider">Archived Payout Ledger</span>
                </div>
            </div>
        </div>

        <% if (typeof withdrawalHistory !== 'undefined' && withdrawalHistory.length > 0) { %>
            <div class="overflow-x-auto">
                <table id="withdrawalHistoryLogGridTable" class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="border-b border-slate-100 text-slate-400 font-bold uppercase tracking-wider">
                            <th class="pb-3 font-semibold">User Profile</th>
                            <th class="pb-3 font-semibold">Blockchain Architecture</th>
                            <th class="pb-3 font-semibold">Target Network Coordinates</th>
                            <th class="pb-3 font-semibold">Volume (USD)</th>
                            <th class="pb-3 font-semibold">Processed Date</th>
                            <th class="pb-3 text-right font-semibold">Audit State Index</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 font-medium text-slate-700">
                        <% withdrawalHistory.forEach(item => { %>
                            <tr class="hover:bg-slate-50/50 transition-colors target-withdrawal-row">
                                <td class="py-3.5">
    <span class="block font-black uppercase text-slate-900 tracking-tight">
        <%= (item.userId && item.userId.username) ? item.userId.username : 'Anonymous Node' %>
    </span>
    
    <span class="text-[10px] text-slate-400 select-all">
        <%= (item.userId && item.userId.email) ? item.userId.email : '' %>
    </span>
</td>
                                <td class="py-3.5">
                                    <span class="inline-block bg-slate-100 px-1.5 py-0.5 rounded text-[10px] font-bold text-slate-600"><%= item.method || 'TRC20' %></span>
                                </td>
                                <td class="py-3.5 font-mono text-[11px] text-slate-500 max-w-[200px] truncate select-all coordinate-string-cell" title="<%= item.address %>">
                                    <%= item.address %>
                                </td>
                                <td class="py-3.5 font-mono text-slate-900 font-bold text-sm">
                                    $<%= parseFloat(item.amount || 0).toFixed(2) %>
                                </td>
                                <td class="py-3.5 text-slate-400 text-[11px]">
                                    <%= new Date(item.updatedAt || item.createdAt || Date.now()).toLocaleString() %>
                                </td>
                                <td class="py-3.5 text-right">
                                    <% if (item.status === 'approved' || item.status === 'verified') { %>
                                        <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 font-black text-[9px] uppercase tracking-widest px-2.5 py-1 rounded-lg">Settled & Approved</span>
                                    <% } else { %>
                                        <span class="bg-rose-50 text-rose-700 border border-rose-200 font-black text-[9px] uppercase tracking-widest px-2.5 py-1 rounded-lg">Declined / Void</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-12 border border-dashed border-slate-200 rounded-2xl bg-slate-50/40">
                <span class="text-3xl block">📋</span>
                <h4 class="font-black text-slate-800 text-xs uppercase tracking-wider mt-3">History Empty</h4>
                <p class="text-slate-400 text-[11px] mt-0.5 max-w-xs mx-auto">No archived withdrawal signatures have been recorded on this administrative segment yet.</p>
            </div>
        <% } %>
    </div>
</div>

