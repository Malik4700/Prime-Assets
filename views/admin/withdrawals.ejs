                            <th class="pb-2.5 font-semibold">Network Cluster</th>
                            <th class="pb-2.5 font-semibold">Assigned Wallet Address Coordinates</th>
                            <th class="pb-2.5 text-right font-semibold">Action Intercepts</th>
