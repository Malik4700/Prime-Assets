<div class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Total Deposit Pool</p>
            <h3 class="text-2xl font-black text-slate-900">$<%= metrics.totalDeposits.toFixed(2) %> <span class="text-xs text-slate-400 font-normal">USD</span></h3>
        </div>
        <div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Total Payouts Withdrawn</p>
            <h3 class="text-2xl font-black text-slate-900">$<%= metrics.totalWithdrawals.toFixed(2) %> <span class="text-xs text-slate-400 font-normal">USD</span></h3>
        </div>
        <div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Total Managed Users</p>
            <h3 class="text-2xl font-black text-slate-900"><%= metrics.totalUsers %> <span class="text-xs text-slate-400 font-normal">Profiles</span></h3>
        </div>
    </div>

    <div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
        <h3 class="text-xs font-black uppercase text-slate-400 tracking-wider mb-4">Active Plan Run Durations Distribution</h3>
        <div class="grid grid-cols-2 sm:grid-cols-6 gap-4 text-center">
            <div class="bg-slate-50 p-3 rounded-xl border">
                <p class="text-lg font-black text-slate-900"><%= metrics.plans["7"] || 0 %></p>
                <p class="text-[9px] font-black uppercase text-slate-400 tracking-wider">7 Days (T1)</p>
            </div>
            <div class="bg-slate-50 p-3 rounded-xl border">
                <p class="text-lg font-black text-slate-900"><%= metrics.plans["15"] || 0 %></p>
                <p class="text-[9px] font-black uppercase text-slate-400 tracking-wider">15 Days (T2)</p>
            </div>
            <div class="bg-slate-50 p-3 rounded-xl border">
                <p class="text-lg font-black text-slate-900"><%= metrics.plans["30"] || 0 %></p>
                <p class="text-[9px] font-black uppercase text-slate-400 tracking-wider">30 Days (T3)</p>
            </div>
            <div class="bg-slate-50 p-3 rounded-xl border">
                <p class="text-lg font-black text-slate-900"><%= metrics.plans["30_premium"] || 0 %></p>
                <p class="text-[9px] font-black uppercase text-slate-400 tracking-wider">30 Days VIP (T4)</p>
            </div>
            <div class="bg-slate-50 p-3 rounded-xl border">
                <p class="text-lg font-black text-slate-900"><%= metrics.plans["60"] || 0 %></p>
                <p class="text-[9px] font-black uppercase text-slate-400 tracking-wider">60 Days (T5)</p>
            </div>
            <div class="bg-slate-50 p-3 rounded-xl border">
                <p class="text-lg font-black text-slate-900"><%= metrics.plans["60_platinum"] || 0 %></p>
                <p class="text-[9px] font-black uppercase text-slate-400 tracking-wider">60 Days Plat (T6)</p>
            </div>
        </div>
    </div>
</div>