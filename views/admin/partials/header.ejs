<header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-8 sticky top-0 z-20">
    <h2 id="viewTitle" class="text-sm font-black uppercase tracking-wider text-slate-400">Overview Core</h2>
    
    <div class="flex items-center space-x-4">
        <div class="flex items-center space-x-2 bg-slate-100 p-1.5 rounded-xl border">
            <button onclick="setOnlineStatus(true)" id="statusOnlineBtn" class="bg-emerald-500 text-white font-black text-[10px] uppercase tracking-wider px-3 py-1 rounded-lg shadow-sm transition-all">Online</button>
            <button onclick="setOnlineStatus(false)" id="statusOfflineBtn" class="text-slate-400 font-black text-[10px] uppercase tracking-wider px-3 py-1 rounded-lg transition-all">Offline</button>
        </div>
 
        <div class="flex items-center space-x-2 text-xs font-bold text-slate-600 border-l pl-4">
            <span id="headerPulseIndicator" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="headerPulseText">Operational Node Active</span>
        </div>
    </div>
</header>