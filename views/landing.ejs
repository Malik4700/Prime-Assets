    <!-- Script Handlers -->
    <script>
    function triggerUplinkAlert() {
        const overlay = document.getElementById('uplink-popup-overlay');
        overlay.classList.remove('hidden');
    }
    function closeUplinkAlert() {
        const overlay = document.getElementById('uplink-popup-overlay');
        overlay.classList.add('hidden');
    }
    document.getElementById('uplink-popup-overlay').addEventListener('click', closeUplinkAlert);
    </script>

